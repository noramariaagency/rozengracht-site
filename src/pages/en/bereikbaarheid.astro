---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BereikbaarheidKaart from '../../components/BereikbaarheidKaart.astro';
import ContentCard from '../../components/ContentCard.astro';
import bereikbaarheidPlekken from '../../data/bereikbaarheid-places.json';
import bereikbaarheidRoutes from '../../data/bereikbaarheid-routes.json';
import { getCollection, getEntry } from 'astro:content';
import { nieuwsToItem, resolveFoto } from '../../lib/items';
import type { Lang } from '../../lib/i18n';

const lang: Lang = 'en';

const routes = [
  {
    titel: 'On foot',
    cat: 'lopend',
    icoon: '<path d="M12 21s-7-5.4-7-11a7 7 0 1 1 14 0c0 5.6-7 11-7 11Z" /><circle cx="12" cy="10" r="2.5" />',
    tekst: 'From Dam Square: take Raadhuisstraat west. Past the Westerkerk and Westermarkt it runs straight into the Rozengracht, about a 10-minute walk.',
  },
  {
    titel: 'By bike',
    cat: 'fiets',
    icoon: '<circle cx="18.5" cy="17.5" r="3.5" /><circle cx="5.5" cy="17.5" r="3.5" /><circle cx="15" cy="5" r="1" /><path d="M12 17.5V14l-3-3 4-3 2 3h2" />',
    tekst: 'The Rozengracht has its own cycle lane in both directions and connects well to the Prinsengracht, which crosses the street at the Westermarkt.',
  },
  {
    titel: 'By car',
    cat: 'auto',
    icoon: '<rect width="18" height="18" x="3" y="3" rx="2" /><path d="M9 17V7h4a3 3 0 0 1 0 6H9" />',
    tekst: 'Parking on the Rozengracht itself is limited and paid. Parking garage Marnix (Marnixstraat 250) is the nearest garage. The map below also shows the walking route from there to the Rozengracht.',
  },
  {
    titel: 'By public transport',
    cat: 'ov',
    icoon: '<path d="M8 6v6" /><path d="M15 6v6" /><path d="M2 12h19.6" /><path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4a2 2 0 0 0-2 2v10h3" /><circle cx="7" cy="18" r="2" /><circle cx="16" cy="18" r="2" />',
    tekst: 'Trams 13 and 17 stop on the Rozengracht itself. The map below shows every tram and bus stop on the street and within 100 metres of it.',
  },
];

// Fixed getting-there POIs shown on the map below — the "By bike" card
// describes a route rather than a single location, so it deliberately has
// no pin of its own (clicking it just shows every POI again). Location
// data comes from src/data/bereikbaarheid-places.json, filled by the same
// "Places verversen" GitHub Action as the ondernemer pins (see
// scripts/fetch-places.mjs) — a POI without a known location is skipped
// here (never invent a pin).
const poiConfig = [
  { key: 'parkeergarage-marnix', naam: 'Marnix parking garage', vervoerswijze: 'auto' },
  { key: 'tram-westermarkt', naam: 'Westermarkt tram stop', vervoerswijze: 'ov' },
  { key: 'tram-marnixstraat', naam: 'Marnixstraat tram stop', vervoerswijze: 'ov' },
];
const vastePois = poiConfig
  .map((poi) => {
    const plek = bereikbaarheidPlekken[poi.key];
    if (!plek || plek.lat == null || plek.lng == null) return null;
    return { key: poi.key, naam: poi.naam, vervoerswijze: poi.vervoerswijze, lat: plek.lat, lng: plek.lng };
  })
  .filter((x) => x !== null);

// Every dynamically-discovered tram/bus stop within 100m of the Rozengracht
// (see scripts/fetch-places.mjs, "ov-" keys) — on top of the two fixed tram
// stops above, so other stops (e.g. buses) also show up on the map without
// needing to be maintained by hand.
const dynamischeOvHaltes = Object.entries(bereikbaarheidPlekken)
  .filter(([key, plek]) => key.startsWith('ov-') && plek && plek.lat != null && plek.lng != null)
  .map(([key, plek]) => ({
    key,
    naam: plek.naamGevonden ?? 'Tram/bus stop',
    vervoerswijze: 'ov',
    lat: plek.lat,
    lng: plek.lng,
  }));

const kaartItems = [...vastePois, ...dynamischeOvHaltes];

// Both route lines come ready-made from the Directions API (see
// scripts/fetch-places.mjs, verversRoutes) — a real, road-network-following
// polyline instead of a hand-chained sequence of separately looked-up
// places (that only produced a few straight segments cutting straight
// through blocks/canals). If a route is missing (e.g. before the first
// "Places verversen" run), nothing is drawn instead of an invented line.
const walkRoute = bereikbaarheidRoutes.lopend?.length > 1 ? bereikbaarheidRoutes.lopend : null;
const garageRoute = bereikbaarheidRoutes.auto?.length > 1 ? bereikbaarheidRoutes.auto : null;

// Getting-there updates are just news articles with category
// "bereikbaarheid" (see src/content/config.ts) — here we only show the
// most recent, active one (a list of every active update added little once
// more than one is active at the same time). Every getting-there update,
// including older/expired ones, stays findable on /nieuws.
const vandaag = new Date();
const bereikbaarheidBerichten = (await getCollection('nieuws'))
  .filter((n) => n.data.categorie === 'bereikbaarheid')
  .filter((n) => !n.data.tot || n.data.tot >= vandaag)
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf());
const laatsteUpdateEntry = bereikbaarheidBerichten[0] ?? null;
const laatsteUpdateItem = laatsteUpdateEntry
  ? nieuwsToItem(
      laatsteUpdateEntry,
      laatsteUpdateEntry.data.gerelateerde_ondernemer
        ? await getEntry(laatsteUpdateEntry.data.gerelateerde_ondernemer)
        : null,
      await resolveFoto(laatsteUpdateEntry.data.foto, 640, laatsteUpdateEntry.data.fotoFocus),
      lang
    )
  : null;
---
<BaseLayout fullBleed title="Getting there" description="How to reach the Rozengracht in Amsterdam: on foot, by bike, by car or by public transport, plus current updates about roadworks and events." lang={lang}>
  <section class="bereik-zone">
    <div class="zone-inner">
      <span class="eyebrow">The street</span>
      <h1>Getting there</h1>
      <p class="intro">The Rozengracht runs east to west through the Jordaan and is easy to reach from every direction.</p>

      <section class="updates-section">
        {laatsteUpdateItem ? (
          <ContentCard item={laatsteUpdateItem} variant="compact" />
        ) : (
          <p class="geen-updates">Nothing to report right now: the Rozengracht is accessible as usual.</p>
        )}
      </section>

      <!-- Tegels boven de kaart, en compacter dan eerst: zo begint de kaart
           net binnen het beeld in plaats van eronder te verdwijnen. -->
      <div class="routes-grid" data-filters role="group" aria-label="Filter by transport mode">
        {routes.map((route) => (
          <button type="button" class="route-card filter-btn" data-cat={route.cat} aria-pressed="false">
            <span class="route-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={route.icoon} />
            </span>
            <span class="route-tekst">
              <h2>{route.titel}</h2>
              <p>{route.tekst}</p>
            </span>
            <span class="route-chevron" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
            </span>
          </button>
        ))}
      </div>

      {kaartItems.length > 0 && <BereikbaarheidKaart items={kaartItems} routes={{ lopend: walkRoute, auto: garageRoute }} />}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // is:inline instead of a hoisted module script, same reason as elsewhere
  // in this codebase. Only toggles the active-button styling on the route
  // cards; the actual pin filtering happens independently inside
  // BereikbaarheidKaart.astro, which listens for the same [data-filters]
  // clicks.
  var routeFilterBar = document.querySelector('.routes-grid[data-filters]');
  routeFilterBar && routeFilterBar.addEventListener('click', (e) => {
    var btn = e.target.closest('.filter-btn');
    if (!btn) return;
    routeFilterBar.querySelectorAll('.filter-btn').forEach((b) => {
      b.classList.remove('is-active');
      b.setAttribute('aria-pressed', 'false');
    });
    btn.classList.add('is-active');
    btn.setAttribute('aria-pressed', 'true');
  });
</script>

<style>
  /* Donkergroene pagina op verzoek: de bereikbaarheidspagina is de plek waar
     mensen komen kijken of ze er wel kunnen komen, en die mag zich
     onderscheiden van de rest van de site. Loopt van rand tot rand, vandaar
     fullBleed op de layout en de 100vw-truc hieronder. */
  .bereik-zone {
    background: var(--green-deep);
    color: #fbfaf7;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding: var(--space-lg) 0 var(--space-xl);
    min-height: 100vh;
  }
  .zone-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-md);
  }
  .bereik-zone :global(h1) { color: #fbfaf7; }
  .eyebrow {
    display: block;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rose);
    font-weight: 600;
    margin-bottom: 6px;
  }
  .intro { color: rgba(251, 250, 247, 0.78); max-width: 560px; margin-top: var(--space-xs); }

  /* Compacter dan eerst (icoon naast de tekst i.p.v. erboven, minder padding)
     zodat alle vier de tegels op een rij passen en de kaart eronder nog
     binnen het beeld begint. */
  .routes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-sm);
    margin: var(--space-lg) 0 var(--space-md);
  }
  /* Dat het knoppen zijn moest duidelijker: ze hebben nu een eigen vlak met
     rand, een chevron die bij hover meebeweegt, en een duidelijk andere
     ingedrukte staat (wit vlak, donkere tekst). */
  .route-card {
    position: relative;
    display: grid;
    grid-template-columns: 34px 1fr 14px;
    align-items: start;
    gap: 12px;
    width: 100%;
    text-align: left;
    font: inherit;
    color: #fbfaf7;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.26);
    border-radius: 12px;
    padding: 14px 14px 14px 12px;
    cursor: pointer;
    touch-action: manipulation;
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .route-card:hover { background: rgba(255, 255, 255, 0.13); border-color: rgba(255, 255, 255, 0.45); }
  .route-card:hover .route-chevron { transform: translateX(3px); }
  .route-card:focus-visible { outline: 2px solid #fbfaf7; outline-offset: 2px; }
  .route-card.is-active {
    background: #fbfaf7;
    border-color: #fbfaf7;
    color: var(--green-deep);
  }
  .route-card.is-active .route-icon { background: var(--green-deep); color: #fbfaf7; }
  .route-card.is-active p { color: rgba(20, 52, 42, 0.75); }

  .route-icon {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
    color: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }
  .route-icon svg { width: 18px; height: 18px; }
  .route-card h2 { font-size: 0.98rem; margin: 2px 0 4px; color: inherit; }
  .route-card p {
    font-size: 0.84rem;
    line-height: 1.45;
    color: rgba(251, 250, 247, 0.72);
    margin: 0;
    /* Twee regels, de rest staat in de kaart eronder: anders duwen deze
       tegels de kaart weer uit het beeld. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .route-tekst { min-width: 0; display: block; }
  .route-chevron { align-self: center; opacity: 0.7; transition: transform 0.15s ease; }

  /* De actuele update staat op de donkergroene ondergrond, dus de kaart uit
     ContentCard (die op licht is ontworpen) krijgt hier lichte tekst. */
  .updates-section :global(.content-card.compact) { border-bottom-color: rgba(255, 255, 255, 0.22); }
  .updates-section :global(.content-card.compact h3) { color: #fbfaf7; }
  .updates-section :global(.content-card.compact .compact-date),
  .updates-section :global(.content-card.compact .loc) { color: rgba(251, 250, 247, 0.72); }
  .route-chevron svg { width: 14px; height: 14px; display: block; }

  .updates-section { margin-top: var(--space-md); }
  .geen-updates {
    color: rgba(251, 250, 247, 0.78);
    background: rgba(255, 255, 255, 0.06);
    border: 1px dashed rgba(255, 255, 255, 0.3);
    border-radius: var(--radius);
    padding: var(--space-md);
  }
  @media (prefers-reduced-motion: reduce) {
    .route-card, .route-chevron { transition: none; }
  }
</style>

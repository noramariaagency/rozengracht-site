---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BereikbaarheidKaart from '../../components/BereikbaarheidKaart.astro';
import ContentCard from '../../components/ContentCard.astro';
import bereikbaarheidPlekken from '../../data/bereikbaarheid-places.json';
import { getCollection, getEntry } from 'astro:content';
import { nieuwsToItem, resolveFoto } from '../../lib/items';
import type { Lang } from '../../lib/i18n';

const lang: Lang = 'en';

const routes = [
  {
    titel: 'On foot',
    cat: 'lopend',
    icoon: '<path d="M12 21s-7-5.4-7-11a7 7 0 1 1 14 0c0 5.6-7 11-7 11Z" /><circle cx="12" cy="10" r="2.5" />',
    tekst: 'From Dam Square: take Raadhuisstraat west. Past the Westerkerk and Westermarkt it runs straight into the Rozengracht, about a 10-minute walk.',
  },
  {
    titel: 'By bike',
    cat: 'fiets',
    icoon: '<circle cx="18.5" cy="17.5" r="3.5" /><circle cx="5.5" cy="17.5" r="3.5" /><circle cx="15" cy="5" r="1" /><path d="M12 17.5V14l-3-3 4-3 2 3h2" />',
    tekst: 'The Rozengracht has its own cycle lane in both directions and connects well to the Prinsengracht, which crosses the street at the Westermarkt.',
  },
  {
    titel: 'By car',
    cat: 'auto',
    icoon: '<rect width="18" height="18" x="3" y="3" rx="2" /><path d="M9 17V7h4a3 3 0 0 1 0 6H9" />',
    tekst: 'Parking on the Rozengracht itself is limited and paid. Parking garage Marnix (Marnixstraat 250) is the nearest garage — the map below also shows the walking route from there to the Rozengracht.',
  },
  {
    titel: 'By public transport',
    cat: 'ov',
    icoon: '<path d="M8 6v6" /><path d="M15 6v6" /><path d="M2 12h19.6" /><path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4a2 2 0 0 0-2 2v10h3" /><circle cx="7" cy="18" r="2" /><circle cx="16" cy="18" r="2" />',
    tekst: 'Trams 13 and 17 stop on the Rozengracht itself. The map below shows every tram and bus stop on the street and within 100 metres of it.',
  },
];

// Fixed getting-there POIs shown on the map below — the "By bike" card
// describes a route rather than a single location, so it deliberately has
// no pin of its own (clicking it just shows every POI again). Location
// data comes from src/data/bereikbaarheid-places.json, filled by the same
// "Places verversen" GitHub Action as the ondernemer pins (see
// scripts/fetch-places.mjs) — a POI without a known location is skipped
// here (never invent a pin).
const poiConfig = [
  { key: 'parkeergarage-marnix', naam: 'Marnix parking garage', vervoerswijze: 'auto' },
  { key: 'tram-westermarkt', naam: 'Westermarkt tram stop', vervoerswijze: 'ov' },
  { key: 'tram-marnixstraat', naam: 'Marnixstraat tram stop', vervoerswijze: 'ov' },
];
const vastePois = poiConfig
  .map((poi) => {
    const plek = bereikbaarheidPlekken[poi.key];
    if (!plek || plek.lat == null || plek.lng == null) return null;
    return { key: poi.key, naam: poi.naam, vervoerswijze: poi.vervoerswijze, lat: plek.lat, lng: plek.lng };
  })
  .filter((x) => x !== null);

// Every dynamically-discovered tram/bus stop within 100m of the Rozengracht
// (see scripts/fetch-places.mjs, "ov-" keys) — on top of the two fixed tram
// stops above, so other stops (e.g. buses) also show up on the map without
// needing to be maintained by hand.
const dynamischeOvHaltes = Object.entries(bereikbaarheidPlekken)
  .filter(([key, plek]) => key.startsWith('ov-') && plek && plek.lat != null && plek.lng != null)
  .map(([key, plek]) => ({
    key,
    naam: plek.naamGevonden ?? 'Tram/bus stop',
    vervoerswijze: 'ov',
    lat: plek.lat,
    lng: plek.lng,
  }));

const kaartItems = [...vastePois, ...dynamischeOvHaltes];

// Waypoints for the two route lines — each a real place fetched via the
// Places API (see scripts/fetch-places.mjs) rather than a hand-guessed
// coordinate, so the lines bend a few times along the actual streets
// instead of being one artificially straight diagonal. If a place is
// missing (e.g. before the first "Places verversen" run), the
// corresponding route simply isn't drawn instead of an invented line.
function heeftLocatie(plek) {
  return !!plek && plek.lat != null && plek.lng != null;
}
function naarPunt(plek) {
  return { lat: plek.lat, lng: plek.lng };
}

const damPlek = bereikbaarheidPlekken['dam-amsterdam'];
const raadhuisstraatPlek = bereikbaarheidPlekken['raadhuisstraat-amsterdam'];
const westermarktPlek = bereikbaarheidPlekken['tram-westermarkt'];
const rozengrachtStraatPlek = bereikbaarheidPlekken['rozengracht-straat'];
const parkeergaragePlek = bereikbaarheidPlekken['parkeergarage-marnix'];

// Walking route for the "On foot" card: Dam Square → Raadhuisstraat →
// Westermarkt → Rozengracht, as described in the card text above.
const walkRoute = [damPlek, raadhuisstraatPlek, westermarktPlek, rozengrachtStraatPlek].every(heeftLocatie)
  ? [damPlek, raadhuisstraatPlek, westermarktPlek, rozengrachtStraatPlek].map(naarPunt)
  : null;

// Walking route for the "By car" card: Marnix parking garage → start of the
// Rozengracht, so drivers immediately see how to get from the garage to
// the street.
const garageRoute = [parkeergaragePlek, rozengrachtStraatPlek].every(heeftLocatie)
  ? [parkeergaragePlek, rozengrachtStraatPlek].map(naarPunt)
  : null;

// Getting-there updates are just news articles with category
// "bereikbaarheid" (see src/content/config.ts) — here we only show the
// most recent, active one (a list of every active update added little once
// more than one is active at the same time). Every getting-there update,
// including older/expired ones, stays findable on /nieuws.
const vandaag = new Date();
const bereikbaarheidBerichten = (await getCollection('nieuws'))
  .filter((n) => n.data.categorie === 'bereikbaarheid')
  .filter((n) => !n.data.tot || n.data.tot >= vandaag)
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf());
const laatsteUpdateEntry = bereikbaarheidBerichten[0] ?? null;
const laatsteUpdateItem = laatsteUpdateEntry
  ? nieuwsToItem(
      laatsteUpdateEntry,
      laatsteUpdateEntry.data.gerelateerde_ondernemer
        ? await getEntry(laatsteUpdateEntry.data.gerelateerde_ondernemer)
        : null,
      await resolveFoto(laatsteUpdateEntry.data.foto),
      lang
    )
  : null;
---
<BaseLayout title="Getting there" description="How to reach the Rozengracht in Amsterdam: on foot, by bike, by car or by public transport, plus current updates about roadworks and events." lang={lang}>
  <span class="eyebrow">The street</span>
  <h1>Getting there</h1>
  <p class="intro">The Rozengracht runs east to west through the Jordaan and is easy to reach from every direction.</p>

  <section class="updates-section">
    {laatsteUpdateItem ? (
      <ContentCard item={laatsteUpdateItem} variant="compact" />
    ) : (
      <p class="geen-updates">Nothing to report right now: the Rozengracht is accessible as usual.</p>
    )}
  </section>

  {kaartItems.length > 0 && <BereikbaarheidKaart items={kaartItems} routes={{ lopend: walkRoute, auto: garageRoute }} />}

  <div class="routes-grid" data-filters role="group" aria-label="Filter by transport mode">
    {routes.map((route) => (
      <button type="button" class="route-card filter-btn" data-cat={route.cat} aria-pressed="false">
        <span class="route-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={route.icoon} />
        </span>
        <h2>{route.titel}</h2>
        <p>{route.tekst}</p>
      </button>
    ))}
  </div>
</BaseLayout>

<script is:inline>
  // is:inline instead of a hoisted module script, same reason as elsewhere
  // in this codebase. Only toggles the active-button styling on the route
  // cards; the actual pin filtering happens independently inside
  // BereikbaarheidKaart.astro, which listens for the same [data-filters]
  // clicks.
  var routeFilterBar = document.querySelector('.routes-grid[data-filters]');
  routeFilterBar && routeFilterBar.addEventListener('click', (e) => {
    var btn = e.target.closest('.filter-btn');
    if (!btn) return;
    routeFilterBar.querySelectorAll('.filter-btn').forEach((b) => {
      b.classList.remove('is-active');
      b.setAttribute('aria-pressed', 'false');
    });
    btn.classList.add('is-active');
    btn.setAttribute('aria-pressed', 'true');
  });
</script>

<style>
  .eyebrow {
    display: block;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rose-deep);
    font-weight: 600;
    margin-bottom: 6px;
  }
  .intro { color: var(--color-muted); max-width: 560px; margin-top: var(--space-xs); }

  .routes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-md);
    margin: var(--space-xl) 0 var(--space-lg);
  }
  .route-card {
    display: block;
    width: 100%;
    text-align: left;
    font: inherit;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-md);
    cursor: pointer;
    touch-action: manipulation;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .route-card.is-active {
    border-color: var(--green-deep);
    box-shadow: inset 0 0 0 1px var(--green-deep);
  }
  .route-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--rose-tint);
    color: var(--green-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-sm);
  }
  .route-icon svg { width: 22px; height: 22px; }
  .route-card h2 { font-size: 1.05rem; margin-bottom: 6px; }
  .route-card p { font-size: 0.9rem; color: var(--ink-soft); margin: 0; }

  .updates-section { margin-top: var(--space-lg); }
  .geen-updates {
    color: var(--ink-soft);
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-md);
  }
</style>

---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'nl' } = Astro.props;

const TEKST: Record<Lang, { contact: string; privacy: string; cookies: string; voorkeuren: string; copyright: string }> = {
  nl: {
    contact: 'Contact',
    privacy: 'Privacy',
    cookies: 'Cookies',
    voorkeuren: 'Cookievoorkeuren',
    copyright: 'BIZ Ondernemersvereniging Rozengracht',
  },
  en: {
    contact: 'Contact',
    privacy: 'Privacy',
    cookies: 'Cookies',
    voorkeuren: 'Cookie preferences',
    copyright: 'BIZ Ondernemersvereniging Rozengracht',
  },
};
const t = TEKST[lang];
---
<footer class="site-footer">
  <div class="container footer-inner">
    <p>&copy; {new Date().getFullYear()} {t.copyright}</p>
    <ul>
      <li><a href={getRelativeLocaleUrl(lang, 'contact')}>{t.contact}</a></li>
      <li><a href={getRelativeLocaleUrl(lang, 'privacy')}>{t.privacy}</a></li>
      <li><a href={getRelativeLocaleUrl(lang, 'cookies')}>{t.cookies}</a></li>
      <!-- Geen <a>: dit opent de melding opnieuw i.p.v. naar een pagina te
           gaan. Wordt verborgen als er geen script draait, want dan doet hij
           ook niets. -->
      <li><button type="button" class="voorkeuren-knop" data-cookie-voorkeuren hidden>{t.voorkeuren}</button></li>
    </ul>
  </div>
</footer>

<script is:inline>
  (function () {
    var knop = document.querySelector('[data-cookie-voorkeuren]');
    if (!knop) return;
    knop.hidden = false;
    knop.addEventListener('click', function () {
      if (window.rgCookieVoorkeuren) window.rgCookieVoorkeuren();
    });
  })();
</script>

<style>
  .voorkeuren-knop {
    font: inherit;
    color: inherit;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
  }
  .voorkeuren-knop:hover { color: var(--green-deep); }

  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-xl);
    padding: var(--space-lg) 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .footer-inner ul {
    display: flex;
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-inner a {
    color: var(--color-muted);
    text-decoration: underline;
  }
</style>

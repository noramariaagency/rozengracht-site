---
// English version of the cookie policy. Same facts as the Dutch page.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

const privacy = getRelativeLocaleUrl('en', 'privacy/');
const bijgewerkt = '9 September 2026';
---
<BaseLayout title="Cookie policy" description="Which cookies this site uses, and which it does not." lang="en">
  <div class="tekstpagina">
    <h1>Cookie policy</h1>
    <p class="lead">
      This site sets no cookies of its own and keeps no statistics. The only
      thing we store is the choice you make in the notice at the bottom.
    </p>

    <h2>What we store</h2>
    <table>
      <thead>
        <tr><th>Name</th><th>What it does</th><th>How long</th></tr>
      </thead>
      <tbody>
        <tr>
          <td><code>rg-cookie-consent</code></td>
          <td>
            Remembers whether you want third-party content (the map, the
            Instagram feed) to load, so we do not ask every time.
          </td>
          <td>Until you remove it yourself</td>
        </tr>
      </tbody>
    </table>
    <p>
      Strictly speaking this is not a cookie but something stored in your own
      browser (localStorage). In practice it comes to the same thing: it sits on
      your device and we cannot reach it.
    </p>

    <h2>Third-party content that may set cookies</h2>
    <p>
      If you say yes to third-party content, those companies may set cookies of
      their own. We have no control over that and cannot see into it.
    </p>
    <ul>
      <li><strong>Google Maps</strong> for the map on the businesses page and the getting there page.</li>
      <li>
        <strong>Behold</strong> for the Instagram posts on the home page, and
        with that possibly <strong>Meta</strong>, the company behind Instagram.
      </li>
    </ul>
    <p>
      Without your yes this does not happen: that content is simply not
      requested. See the <a href={privacy}>privacy statement</a> for what does
      and does not happen in that case.
    </p>

    <h2>Changing your mind</h2>
    <p>
      You can do that here, whenever you like. Your current choice:
    </p>
    <div class="keuze-blok" data-keuze-blok>
      <p class="keuze-status" data-keuze-status>Nothing chosen yet.</p>
      <div class="keuze-knoppen">
        <button type="button" class="keuze-btn keuze-btn-ja" data-keuze="alles">Allow third-party content</button>
        <button type="button" class="keuze-btn" data-keuze="noodzakelijk">No thanks</button>
      </div>
    </div>
    <p>
      Your choice only sits in your own browser. Clear your site data and it is
      gone, and you get the notice again.
    </p>

    <h2>What happens without your yes</h2>
    <p>
      Nothing towards another company. The fonts are hosted on our own server,
      so those load without anything going to Google either. If you choose
      nothing, or say no, the whole site still works: you just do not see the
      map and the Instagram posts, and a panel with a button takes their place.
    </p>

    <p class="bijgewerkt">Last updated: {bijgewerkt}.</p>
  </div>
</BaseLayout>

<script is:inline>
  // Leest en zet dezelfde keuze als de melding onderaan (window.rgCookieConsent
  // uit BaseLayout), zodat deze pagina en de melding niet uit elkaar lopen.
  (function () {
    var blok = document.querySelector('[data-keuze-blok]');
    if (!blok || !window.rgCookieConsent) return;
    var status = blok.querySelector('[data-keuze-status]');
    var TEKST = {
      alles: 'Third-party content is allowed: the map and the Instagram feed load.',
      noodzakelijk: 'Third-party content is off: the map and the Instagram feed do not load.',
      leeg: 'Nothing chosen yet. Third-party content does not load.',
    };
    function toon() {
      var keuze = window.rgCookieConsent.get();
      status.textContent = TEKST[keuze] || TEKST.leeg;
      blok.querySelectorAll('[data-keuze]').forEach(function (b) {
        var actief = b.dataset.keuze === keuze;
        b.setAttribute('aria-pressed', actief ? 'true' : 'false');
        b.classList.toggle('is-actief', actief);
      });
    }
    blok.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-keuze]');
      if (!btn) return;
      window.rgCookieConsent.set(btn.dataset.keuze);
      document.dispatchEvent(new CustomEvent('rg-consent', { detail: btn.dataset.keuze }));
      var melding = document.getElementById('cookiebanner');
      if (melding) melding.hidden = true;
      toon();
    });
    document.addEventListener('rg-consent', toon);
    toon();
  })();
</script>

<style>
  .keuze-blok {
    background: var(--cream-card);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 18px 20px;
    margin: var(--space-sm) 0 var(--space-md);
  }
  .keuze-status { margin: 0 0 12px; font-weight: 600; }
  .keuze-knoppen { display: flex; flex-wrap: wrap; gap: 10px; }
  .keuze-btn {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: 100px;
    border: 1px solid var(--color-border);
    background: #fff;
    color: var(--color-text);
    cursor: pointer;
    touch-action: manipulation;
  }
  .keuze-btn.is-actief { background: var(--green-mid); border-color: var(--green-mid); color: #fff; }
  .tekstpagina { max-width: 680px; }
  .tekstpagina .lead { font-size: 1.08rem; line-height: 1.6; color: var(--ink-soft); }
  .tekstpagina h2 { margin-top: 2.2rem; }
  .tekstpagina ul { padding-left: 1.2rem; }
  .tekstpagina li { margin-bottom: 0.5rem; line-height: 1.6; }
  .tekstpagina p { line-height: 1.65; }
  .tekstpagina table { width: 100%; border-collapse: collapse; margin: 1.2rem 0; font-size: 0.94rem; }
  .tekstpagina th, .tekstpagina td { text-align: left; vertical-align: top; padding: 10px 12px; border-bottom: 1px solid var(--color-border); }
  .tekstpagina th { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-soft); }
  .tekstpagina code { font-size: 0.9em; background: var(--cream-card); padding: 2px 6px; border-radius: 5px; }
  .bijgewerkt { margin-top: 2.5rem; font-size: 0.9rem; color: var(--color-muted); }
  @media (max-width: 560px) {
    .tekstpagina table, .tekstpagina thead, .tekstpagina tbody, .tekstpagina tr, .tekstpagina th, .tekstpagina td { display: block; }
    .tekstpagina thead { display: none; }
    .tekstpagina td { border: none; padding: 4px 0; }
    .tekstpagina tr { border-bottom: 1px solid var(--color-border); padding-bottom: 12px; margin-bottom: 12px; }
  }
</style>

---
// "Lezen": het volledige archief van alle blogartikelen — vervangt de oude
// rol van de "Nieuws"-overzichtspagina nu de homepage zelf beperkt is tot de
// laatste 12 (zie components/home/BlogWall.astro).
//
// Historie-verhalen staan er nog niet in: geen publicatiedatum in het
// schema (verzoek aan topic 01 staat in CLAIMS.md) — zodra dat er is, horen
// ze hier gewoon tussen te staan.
//
// Filter op categorie, overgenomen van de gekoppelde ondernemer (diens
// categorie + evt. tweede label, dus een artikel kan onder meerdere
// categorieën vallen — zelfde principe als de kaart-filters). Een artikel
// zonder gekoppelde ondernemer (bv. een algemene aankondiging) matcht geen
// categorie-chip en blijft alleen onder "Alles" zichtbaar. Bereikbaarheid
// is geen ondernemer-categorie, dus die blijft een aparte chip.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getCollection, getEntry } from 'astro:content';
import { nieuwsToItem, themasVoorOndernemer, resolveFoto } from '../../lib/items';
import { categorieenPerGroep } from '../../lib/categorieen';
import type { FeedItem } from '../../lib/items';
import type { Lang } from '../../lib/i18n';

const lang: Lang = 'nl';

const alleNieuwsRuw = (await getCollection('nieuws')).sort(
  (a, b) => b.data.datum.valueOf() - a.data.datum.valueOf()
);
const wall = await Promise.all(
  alleNieuwsRuw.map(async (n) => {
    const ondernemer = n.data.gerelateerde_ondernemer ? await getEntry(n.data.gerelateerde_ondernemer) : null;
    const foto = await resolveFoto(n.data.foto, 640, n.data.fotoFocus);
    const item = nieuwsToItem(n, ondernemer, foto, lang);
    const themas = themasVoorOndernemer(ondernemer);
    if (n.data.categorie === 'bereikbaarheid') themas.push('bereikbaarheid');
    return { item, themas };
  })
);

function formaat(item: FeedItem): 'lg' | 'md' | 'sm' {
  if (item.rawLength > 500) return 'lg';
  if (item.rawLength > 200) return 'md';
  return 'sm';
}

const groepen = categorieenPerGroep(lang);

const TEKST = {
  titel: 'Lezen',
  intro: 'Alle artikelen over de Rozengracht, op volgorde van publicatie.',
  alle: 'Alles',
  bereikbaarheid: 'Bereikbaarheid',
};
---
<BaseLayout title={TEKST.titel} description={TEKST.intro} lang={lang}>
  <h1>{TEKST.titel}</h1>
  <p class="intro">{TEKST.intro}</p>

  <div class="filters" data-filters role="group" aria-label="Filter op categorie">
    <button type="button" class="filter-btn is-active" data-thema="alle" aria-pressed="true">{TEKST.alle}</button>
    <button type="button" class="filter-btn" data-thema="bereikbaarheid" aria-pressed="false">{TEKST.bereikbaarheid}</button>
    {groepen.map((g) => (
      <div class="filter-groep">
        <span class="filter-groep-label">{g.groepLabel}</span>
        <div class="filter-groep-knoppen">
          {g.categorieen.map(([key, label]) => (
            <button type="button" class="filter-btn" data-thema={key} aria-pressed="false">{label}</button>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="wall" data-wall>
    {wall.map(({ item, themas }) => (
      <div class="wall-item" data-themas={themas.join(' ')}>
        <ContentCard item={item} variant="feature" size={formaat(item)} />
      </div>
    ))}
  </div>
</BaseLayout>

<script is:inline>
  var filterBar = document.querySelector('[data-filters]');
  var wallEl = document.querySelector('[data-wall]');
  filterBar && wallEl && filterBar.addEventListener('click', (e) => {
    var btn = e.target.closest('.filter-btn');
    if (!btn) return;
    filterBar.querySelectorAll('.filter-btn').forEach((b) => {
      b.classList.remove('is-active');
      b.setAttribute('aria-pressed', 'false');
    });
    btn.classList.add('is-active');
    btn.setAttribute('aria-pressed', 'true');
    var thema = btn.dataset.thema;
    wallEl.querySelectorAll('[data-themas]').forEach((el) => {
      var themas = (el.dataset.themas || '').split(' ');
      el.style.display = thema === 'alle' || themas.indexOf(thema) !== -1 ? '' : 'none';
    });
  });
</script>

<style>
  .intro { color: var(--color-muted); max-width: 620px; margin-top: var(--space-xs); }

  .filters { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.6rem var(--space-xs); margin: var(--space-lg) 0; }
  .filter-groep { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem var(--space-xs); flex: 0 0 100%; }
  .filter-groep-label {
    flex: 0 0 100%;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .filter-groep-knoppen { display: flex; flex-wrap: wrap; gap: 8px; }
  .filter-btn {
    font-size: 0.85rem;
    font-weight: 500;
    font-family: var(--font-body);
    border: 1px solid var(--color-border);
    background: var(--cream-card);
    padding: 7px 16px;
    border-radius: 100px;
    color: var(--color-text);
    cursor: pointer;
    touch-action: manipulation;
  }
  .filter-btn.is-active { background: var(--green-deep); color: #fff; border-color: var(--green-deep); }

  /* Echte masonry via CSS columns, zie ook home/BlogWall.astro. */
  .wall {
    column-count: 3;
    column-gap: 28px;
    margin-bottom: var(--space-xl);
  }
  .wall-item { break-inside: avoid; margin-bottom: 28px; }
  @media (max-width: 900px) {
    .wall { column-count: 2; }
  }
  @media (max-width: 620px) {
    .wall { column-count: 1; }
  }
</style>

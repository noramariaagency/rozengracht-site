---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FotoFallback from '../../../components/FotoFallback.astro';
import OndernemersKaart from '../../../components/OndernemersKaart.astro';
import plekken from '../../../data/places.json';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCategorieLabels, categorieIconen } from '../../../lib/categorieen';
import type { Lang } from '../../../lib/i18n';

const lang: Lang = 'en';
const categorieLabels = getCategorieLabels(lang);

const ruw = await getCollection(
  'ondernemers',
  ({ data }) => data.status !== 'overslaan' && data.status !== 'geen-interesse'
);

function huisnummerSortValue(h) {
  if (!h) return null;
  const match = h.match(/\d+/);
  return match ? parseInt(match[0], 10) : null;
}

const items = await Promise.all(
  ruw.map(async (o) => {
    const foto = o.data.fotos[0]
      ? await getImage({ src: o.data.fotos[0], width: 360, height: 360 })
      : null;
    return {
      slug: o.slug,
      naam: o.data.naam,
      huisnummer: o.data.huisnummer,
      huisnummerSort: huisnummerSortValue(o.data.huisnummer),
      categorie: o.data.categorie,
      categorieLabel: categorieLabels[o.data.categorie] ?? o.data.categorie,
      foto: foto?.src ?? null,
    };
  })
);

items.sort((a, b) => {
  if (a.huisnummerSort === null && b.huisnummerSort === null) return 0;
  if (a.huisnummerSort === null) return 1;
  if (b.huisnummerSort === null) return -1;
  return a.huisnummerSort - b.huisnummerSort;
});

// Alleen ondernemers met een bekende locatie (uit places.json, via de
// Places API opgehaald) krijgen een pin — geen coordinaten verzinnen voor
// de rest.
const kaartItems = items
  .map((item) => {
    const plek = plekken[item.slug];
    if (!plek || plek.lat == null || plek.lng == null) return null;
    // Sanity-check tegen een verkeerd gegokte Places-match (bv. een
    // gelijknamige zaak in een andere stad) — buiten een ruime bounding
    // box rond de Rozengracht negeren we de pin liever dan de hele kaart
    // (via fitBounds) helemaal uit te laten zoomen voor iedereen.
    if (plek.lat < 52.3 || plek.lat > 52.42 || plek.lng < 4.8 || plek.lng > 4.95) return null;
    return {
      slug: item.slug,
      naam: item.naam,
      categorie: item.categorie,
      lat: plek.lat,
      lng: plek.lng,
      href: getRelativeLocaleUrl(lang, `ondernemers/${item.slug}/`),
    };
  })
  .filter((x) => x !== null);

const categorieen = Object.entries(categorieLabels);
---
<BaseLayout title="Businesses" description="All the businesses on the Rozengracht in Amsterdam, in order of house number." lang={lang}>
  <h1>Businesses on the Rozengracht</h1>
  <p style="color: var(--color-muted); max-width: 640px;">
    {items.length} businesses, in order of house number: from the Westermarkt to the Marnixstraat. Click a card for more info.
  </p>

  <OndernemersKaart items={kaartItems} />

  <section class="ondernemers-zone">
    <div class="zone-inner">
      <div class="filters" data-filters role="group" aria-label="Filter by category">
        <button class="filter-btn is-active" data-cat="alle" type="button" aria-pressed="true">All</button>
        {categorieen.map(([key, label]) => (
          <button class="filter-btn" data-cat={key} type="button" aria-pressed="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={categorieIconen[key]} />
            <span>{label}</span>
          </button>
        ))}
      </div>

      <div class="ondernemers-grid" data-grid>
        {items.map((item) => (
          <a class="ondernemer-card" href={getRelativeLocaleUrl(lang, `ondernemers/${item.slug}/`)} data-cat={item.categorie}>
            <div class="photo-wrap">
              {item.foto ? (
                <img class="photo" src={item.foto} alt={item.naam} width="360" height="360" loading="lazy" />
              ) : (
                <FotoFallback categorie={item.categorie} />
              )}
              {item.huisnummer && <span class="huisnr-badge">{item.huisnummer}</span>}
            </div>
            <h2>{item.naam}</h2>
            <div class="role">{item.categorieLabel}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    var filterBar = document.querySelector('[data-filters]');
    filterBar && filterBar.addEventListener('click', (e) => {
      var btn = e.target.closest('.filter-btn');
      if (!btn) return;
      filterBar.querySelectorAll('.filter-btn').forEach((b) => {
        b.classList.remove('is-active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-pressed', 'true');
      var cat = btn.dataset.cat;
      document.querySelectorAll('.ondernemer-card').forEach((el) => {
        var visible = cat === 'alle' || el.dataset.cat === cat;
        el.classList.toggle('is-filtered-out', !visible);
      });
    });
  </script>
</BaseLayout>

<style>
  .ondernemers-zone {
    background: var(--green-deep);
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: var(--space-lg);
    padding: var(--space-lg) 0 var(--space-xl);
  }
  .zone-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-md);
  }

  .filters {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
    margin: 0 0 var(--space-md);
  }
  .filter-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.24);
    color: #fbfaf7;
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    font-size: 0.85rem;
    font-family: var(--font-body);
    cursor: pointer;
    touch-action: manipulation;
  }
  .filter-btn svg { width: 16px; height: 16px; }
  .filter-btn.is-active {
    background: #fbfaf7;
    color: var(--green-deep);
    border-color: #fbfaf7;
  }

  .ondernemers-grid {
    display: grid;
    gap: var(--space-md) var(--space-lg);
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  }
  .ondernemer-card { text-decoration: none; color: #fbfaf7; display: block; }
  .ondernemer-card.is-filtered-out { display: none; }
  .ondernemer-card .photo-wrap {
    position: relative;
    aspect-ratio: 1/1;
    border-radius: 12px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.15);
    margin-bottom: 12px;
    overflow: hidden;
  }
  .ondernemer-card .photo { width: 100%; height: 100%; border-radius: 0; object-fit: cover; }
  .ondernemer-card .photo-wrap :global(.foto-fallback) { background: linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04)); color: #fbfaf7; }
  .ondernemer-card h2 { font-size: 0.98rem; font-weight: 600; margin-bottom: 2px; color: #fbfaf7; }
  .ondernemer-card .role { font-size: 0.82rem; color: rgba(251, 250, 247, 0.65); }
  .huisnr-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(18, 36, 29, 0.78);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }
</style>

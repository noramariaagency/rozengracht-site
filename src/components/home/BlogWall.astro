---
// De homepage is een blog, geen nieuwswebsite: dit is de ene, ongetitelde
// "wall" direct onder de bereikbaarheidsbalk en de event-highlight. Geen
// aparte "Nieuws & updates"- of "Uitgelicht"-koppen meer, en geen aparte
// kolom voor bereikbaarheid-artikelen: alles staat gewoon tussen elkaar in
// de wand, op volgorde van publicatie.
//
// Historie-verhalen lopen mee zodra ze een publicatiedatum hebben (het veld
// `gepubliceerd`): dan staan ze gewoon tussen de artikelen op die datum.
// Heeft een verhaal die datum niet, dan blijft het hier weg en is het via
// Historie in het menu te vinden. We gokken geen plek in de tijdlijn.
//
// Layout: CSS columns (echte masonry, geen grid-met-spans) — elke kolom
// gelijk breed, de foto's variëren in hoogte (zie ContentCard's size-prop),
// dat geeft het ongelijke ritme van beethovenstraat.nl.
import ContentCard from '../ContentCard.astro';
import { getCollection, getEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { nieuwsToItem, verhaalToItem, resolveFoto } from '../../lib/items';
import type { FeedItem } from '../../lib/items';
import type { Lang } from '../../lib/i18n';

// Cap op de homepage — geen eindeloze lijst hier, de volledige lijst staat
// op /lezen/.
const AANTAL = 12;

interface Props {
  lang?: Lang;
}
const { lang = 'nl' } = Astro.props;

// Nieuws en gepubliceerde historie-verhalen door elkaar, op datum. Eerst
// samenvoegen en sorteren, dan pas afkappen op AANTAL: anders zou een oud
// nieuwsbericht een recenter verhaal van de homepage duwen.
type Bron =
  | { soort: 'nieuws'; datum: Date; entry: Awaited<ReturnType<typeof getCollection<'nieuws'>>>[number] }
  | { soort: 'verhaal'; datum: Date; entry: Awaited<ReturnType<typeof getCollection<'verhalen'>>>[number] };

const bronnen: Bron[] = [
  ...(await getCollection('nieuws')).map(
    (entry) => ({ soort: 'nieuws', datum: entry.data.datum, entry }) as Bron
  ),
  ...(await getCollection('verhalen'))
    .filter((entry) => entry.data.gepubliceerd)
    .map((entry) => ({ soort: 'verhaal', datum: entry.data.gepubliceerd!, entry }) as Bron),
];
bronnen.sort((a, b) => b.datum.valueOf() - a.datum.valueOf());

const wall = await Promise.all(
  bronnen.slice(0, AANTAL).map(async (bron) => {
    const data = bron.entry.data as any;
    const ondernemer = data.gerelateerde_ondernemer ? await getEntry(data.gerelateerde_ondernemer) : null;
    const foto = await resolveFoto(data.foto, 640, data.fotoFocus);
    return bron.soort === 'nieuws'
      ? nieuwsToItem(bron.entry as any, ondernemer, foto, lang)
      : verhaalToItem(bron.entry as any, ondernemer, foto, lang);
  })
);

// Foto-formaat: hoe meer tekst het artikel echt heeft (rawLength, dus vóór
// de tekens-afkap van excerpt), hoe groter/hoger de foto — dezelfde
// gedachte als op beethovenstraat.nl.
function formaat(item: FeedItem): 'lg' | 'md' | 'sm' {
  if (item.rawLength > 500) return 'lg';
  if (item.rawLength > 200) return 'md';
  return 'sm';
}

const TEKST: Record<Lang, string> = {
  nl: 'Meer artikelen',
  en: 'More articles',
};
---
<div class="container">
  <div class="blog-wall">
    {wall.map((item) => (
      <div class="wall-item reveal-item">
        <ContentCard item={item} variant="feature" size={formaat(item)} bordered={false} />
      </div>
    ))}
  </div>
  <a class="meer-link" href={getRelativeLocaleUrl(lang, 'lezen')}>{TEKST[lang]} &rarr;</a>
</div>

<style>
  /* Gewoon de sitebreedte, niet breder. Het extra brede magazine-formaat
     werkte niet: de wand liep buiten de rest van de site en dat viel uit de
     toon met de koppen en de nav erboven. */

  /* Echte masonry via CSS columns i.p.v. een grid met wisselende spans: hier
     bepaalt de eigen hoogte van elke kaart (foto-verhouding + tekstlengte)
     waar hij in zijn kolom terechtkomt, precies het ritme van
     beethovenstraat.nl, i.p.v. brede/smalle vakken die als een aparte
     sidebar naast elkaar ogen. */
  .blog-wall {
    column-count: 3;
    column-gap: 28px;
    padding: 32px 0 40px;
  }
  .wall-item { break-inside: avoid; margin-bottom: 28px; }
  @media (max-width: 900px) {
    .blog-wall { column-count: 2; }
  }
  @media (max-width: 620px) {
    .blog-wall { column-count: 1; }
  }

  .meer-link {
    display: block;
    width: fit-content;
    margin: 0 auto 56px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--green-deep);
    border-bottom: 1px solid var(--rose);
    padding-bottom: 2px;
    text-decoration: none;
  }

  .reveal-item {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .reveal-item.is-visible { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    .reveal-item { opacity: 1; transform: none; transition: none; }
  }
</style>

---
// "Nieuw op de Rozengracht": ondernemers die er maximaal een half jaar
// zitten (punt 2 uit de briefing). De grens is datum-gedreven vanaf
// `nieuw_sinds` — geen handmatige knop die kan gaan verouderen. De sectie
// verdwijnt volledig zodra er niets nieuws is: geen lege kop, geen
// "nog geen nieuwe ondernemers"-tekst.
import FotoFallback from '../FotoFallback.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCategorieLabels } from '../../lib/categorieen';
import type { Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'nl' } = Astro.props;

const HALF_JAAR_MS = 183 * 24 * 60 * 60 * 1000;
const vandaag = new Date();
const categorieLabels = getCategorieLabels(lang);

const alleOndernemers = await getCollection(
  'ondernemers',
  ({ data }) => data.status !== 'overslaan' && data.status !== 'geen-interesse'
);
const nieuwRuw = await Promise.all(
  alleOndernemers
    .filter((o) => o.data.nieuw_sinds && vandaag.getTime() - o.data.nieuw_sinds.getTime() <= HALF_JAAR_MS)
    .map(async (o) => {
      const foto = o.data.fotos[0] ? await getImage({ src: o.data.fotos[0], width: 360, height: 360 }) : null;
      return {
        slug: o.slug,
        naam: o.data.naam,
        categorie: o.data.categorie,
        categorieLabel: categorieLabels[o.data.categorie] ?? o.data.categorie,
        foto: foto?.src ?? null,
        nieuwSinds: o.data.nieuw_sinds,
      };
    })
);
const nieuw = nieuwRuw.sort((a, b) => b.nieuwSinds!.valueOf() - a.nieuwSinds!.valueOf());

// Geen eyebrow-regel erboven: "Nieuw op de Rozengracht" is de letterlijke
// naam uit de ruwe notities, een uitgevonden eyebrow ("Vers binnen") stond
// daar niet bij en is geschrapt na feedback dat hij niet uit de notities kwam.
const TEKST: Record<Lang, { titel: string }> = {
  nl: { titel: 'Nieuw op de Rozengracht' },
  en: { titel: 'New on the Rozengracht' },
};
const t = TEKST[lang];
---
{nieuw.length > 0 && (
  <div class="nieuw-op-de-rozengracht">
    <div class="sub-head">
      <h3>{t.titel}</h3>
    </div>
    <div class="strip-scroll">
      {nieuw.map((o) => (
        <a class="maker-card" href={getRelativeLocaleUrl(lang, `ondernemers/${o.slug}`)}>
          <div class="photo-wrap">
            {o.foto ? (
              <img class="photo" src={o.foto} alt={o.naam} width="360" height="360" loading="lazy" />
            ) : (
              <FotoFallback categorie={o.categorie} />
            )}
          </div>
          <h4>{o.naam}</h4>
          <div class="role">{o.categorieLabel}</div>
        </a>
      ))}
    </div>
  </div>
)}

<style>
  /* color hier expliciet zetten: dit component staat op het donkergroene
     deel, maar heeft (anders dan de pagina zelf) geen eigen ".ontdek-zone
     h3"-regel om op te liften — Astro's scoped styles laten paginastijlen
     nooit binnen een child-component doorwerken. Zonder deze regel viel de
     kop terug op het globale, bijna zwarte h1/h2/h3-kleur uit global.css,
     onleesbaar op donkergroen. */
  .sub-head { margin-bottom: 26px; }
  .sub-head h3 { font-size: 1.3rem; margin: 0; color: #fbfaf7; }

  /* Geen reveal-on-scroll op deze kaartjes: het zijn horizontaal scrollende
     items (overflow-x: auto), en de IntersectionObserver rekent horizontale
     clipping door een scrollbare ancestor mee — kaartjes buiten de
     horizontale scrollpositie kruisen het viewport dus nooit. */
  .strip-scroll { display: flex; gap: 24px; overflow-x: auto; padding: 4px 4px 14px; scrollbar-width: thin; }
  .maker-card { flex: 0 0 180px; text-decoration: none; color: inherit; display: block; }
  .maker-card .photo-wrap {
    position: relative;
    aspect-ratio: 1/1;
    border-radius: 12px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.15);
    margin-bottom: 12px;
    overflow: hidden;
  }
  .maker-card .photo { width: 100%; height: 100%; border-radius: 0; object-fit: cover; }
  .maker-card .photo-wrap :global(.foto-fallback) { background: linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04)); color: #fbfaf7; }
  .maker-card h4 { font-size: 0.98rem; font-weight: 600; font-family: var(--font-heading); color: #fbfaf7; margin-bottom: 2px; }
  .maker-card .role { font-size: 0.78rem; color: rgba(251, 250, 247, 0.62); margin-bottom: 8px; }
</style>

---
// Lettertypen staan op onze eigen server in plaats van bij Google Fonts.
// Daarvoor laadde elke pagina drie families rechtstreeks bij Google, wat
// betekende dat het IP-adres van elke bezoeker daarheen ging voordat die iets
// kon kiezen. Nu worden de woff2-bestanden meegebouwd en vanaf ons eigen
// domein geleverd: geen derde partij meer in de gewone pageload, en het scheelt
// ook nog een externe verbinding. De families heten in deze pakketten
// "... Variable"; de gewone naam staat er als terugval achter in global.css.
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/public-sans';
import '@fontsource-variable/public-sans/wght-italic.css';
import '@fontsource-variable/petrona';
import '@fontsource-variable/petrona/wght-italic.css';
import Nav from '../components/Nav.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Footer from '../components/Footer.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { kaalPad, type Lang } from '../lib/i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  fullBleed?: boolean;
  lang?: Lang;
}

const {
  title,
  description = 'BIZ Ondernemersvereniging Rozengracht, Amsterdam',
  fullBleed = false,
  lang = 'nl',
} = Astro.props;

// hreflang-alternates: het pad van de HUIDIGE pagina, in beide talen. Zo
// weten zoekmachines dat / en /en/ (en elke onderliggende pagina) elkaars
// vertaling zijn, i.p.v. losse pagina's.
const base = import.meta.env.BASE_URL;
const restPad = kaalPad(Astro.url.pathname, base);
const nlHref = getRelativeLocaleUrl('nl', restPad);
const enHref = getRelativeLocaleUrl('en', restPad);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | De Rozengracht</title>
    <meta name="description" content={description} />
    <!-- PREVIEW-FASE: voorkomt dat zoekmachines deze (nog niet definitieve) preview-URL
         indexeren. Verwijder deze regel zodra de site echt live gaat op het eigen domein. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="alternate" hreflang="nl" href={new URL(nlHref, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enHref, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(nlHref, Astro.site)} />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <Nav lang={lang} />
    {fullBleed ? (
      <main id="main-content">
        <slot />
      </main>
    ) : (
      <main id="main-content" class="container" style="padding-top: 2.5rem; padding-bottom: 2.5rem;">
        <slot />
      </main>
    )}
    <Footer lang={lang} />
    <!-- Cookiebanner-haak: topic 07 vult dit element met de banner-markup en
         -tekst en de bijbehorende logica. Dit fundament biedt alleen de
         plek in de layout plus een simpele opslaghelper voor de
         toestemmingsstatus, zodat 07 niet ook nog BaseLayout.astro hoeft
         aan te raken. -->
    <script is:inline>
      window.rgCookieConsent = {
        sleutel: 'rg-cookie-consent',
        get() {
          try {
            return localStorage.getItem(this.sleutel);
          } catch (e) {
            return null;
          }
        },
        set(waarde) {
          try {
            localStorage.setItem(this.sleutel, waarde);
          } catch (e) {}
        },
        // Mogen externe onderdelen (Google-kaart, Instagram-feed) geladen
        // worden? Alleen als de bezoeker daar expliciet ja op heeft gezegd.
        // Geen antwoord betekent nee: liever een kaart die de bezoeker zelf
        // aanzet dan een IP-adres dat al weg is voor iemand iets kon kiezen.
        magExtern() {
          return this.get() === 'alles';
        },
      };
    </script>
    <div id="cookiebanner-root"><CookieBanner lang={lang} /></div>
  </body>
</html>

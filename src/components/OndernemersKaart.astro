---
// Interactieve kaart met een pin per ondernemer (i.p.v. de eerdere platte
// straat-embed zonder pins). Gebruikt de Maps JavaScript API met de
// publieke, referrer-beperkte sleutel (zie Google Cloud Console — alleen
// bruikbaar vanaf de bekende site-domeinen, dus veilig om hier client-side
// te gebruiken). Locatiedata komt uit src/data/places.json, dat apart via
// de "Places verversen" GitHub Action wordt gevuld — ondernemers zonder
// bekende locatie worden hier gewoon overgeslagen (geen pin verzinnen).
import { categorieIconen, categorieKleuren } from '../lib/categorieen';
import ExternToestemming from './ExternToestemming.astro';

export interface Props {
  items: {
    slug: string;
    naam: string;
    categorie: string;
    tweedeLabel?: string | null;
    lat: number;
    lng: number;
    href: string;
    // Voor het infokaartje bij een klik op de pin. Adres komt uit het
    // huisnummer op de ondernemerspagina; uren en placeId komen uit
    // places.json, dus rechtstreeks van Google.
    adres?: string;
    uren?: Record<string, string> | null;
    placeId?: string | null;
  }[];
  // 'cta' = donkere call-to-action-sectie op de homepage (andere
  // beeldverhouding/rand dan het standaard gebruik op de
  // ondernemers-overzichtspagina's).
  variant?: 'standaard' | 'cta' | 'zone';
  class?: string;
}
const { items, variant = 'standaard', class: className } = Astro.props;

// Referrer-beperkte publieke sleutel (alleen te gebruiken vanaf
// derozengracht.com / www.derozengracht.com / noramariaagency.github.io) —
// geen server-side geheim, vandaar hier direct in de client-code.
const MAPS_KEY = 'AIzaSyCJ91Qc-ndwZUT2VVnHXbT3V--IN2KDmEQ';

// Kleur + icoon per categorie op de pin zelf, i.p.v. 100+ identieke rode
// druppels — dat liet geen enkel patroon zien. Wordt hier server-side
// samengesteld tot kant-en-klare data-URI's (geen canvas/afbeeldingen
// nodig), zodat het client-scriptje er alleen nog een categorie-lookup op
// hoeft te doen. Kleur ís niet de enige drager van betekenis: het
// bijpassende lijn-icoon (dezelfde set als op de filterknoppen) staat er
// altijd bovenop in het wit.
const STANDAARD_KLEUR = '#1b3b2f';
function pinIconSvg(kleur: string, iconPath: string) {
  return (
    `<svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 30 30">` +
    `<circle cx="15" cy="15" r="13" fill="${kleur}" stroke="#ffffff" stroke-width="2"/>` +
    `<g transform="translate(7,7) scale(0.667)" fill="none" stroke="#ffffff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">${iconPath}</g>` +
    `</svg>`
  );
}
const markerIconsPerCategorie: Record<string, string> = {
  __standaard__: `data:image/svg+xml,${encodeURIComponent(pinIconSvg(STANDAARD_KLEUR, ''))}`,
};
for (const [cat, iconPath] of Object.entries(categorieIconen)) {
  const kleur = categorieKleuren[cat] ?? STANDAARD_KLEUR;
  markerIconsPerCategorie[cat] = `data:image/svg+xml,${encodeURIComponent(pinIconSvg(kleur, iconPath))}`;
}
---
<ExternToestemming />

<div
  id="ondernemers-kaart"
  class:list={[
    'locatie-kaart',
    variant === 'cta' && 'locatie-kaart--cta',
    variant === 'zone' && 'locatie-kaart--zone',
    className,
  ]}
  data-items={JSON.stringify(items)}
  data-maps-key={MAPS_KEY}
  data-marker-icons={JSON.stringify(markerIconsPerCategorie)}
>
</div>

<script is:inline>
  // is:inline i.p.v. een gehoiste module-script — zelfde reden als elders in
  // deze codebase (blijft ook werken in een file://-preview). Geen
  // TypeScript-syntax hier.
  //
  // Let op: dit component kan meerdere keren op dezelfde pagina voorkomen
  // is (nu) niet het geval, maar de callback-functie werkt globaal via
  // window.initOndernemersKaart — bij hergebruik zou dit herzien moeten
  // worden. Voor nu: precies één kaart per pagina (homepage-CTA of
  // ondernemers-overzicht, nooit beide tegelijk).
  function initOndernemersKaart() {
    var el = document.getElementById('ondernemers-kaart');
    if (!el) return;
    var items = JSON.parse(el.dataset.items || '[]');
    if (items.length === 0) return;
    var iconMap = JSON.parse(el.dataset.markerIcons || '{}');

    var map = new google.maps.Map(el, {
      center: { lat: 52.3735, lng: 4.8815 },
      zoom: 15,
      mapId: undefined,
      // Google zet standaard zijn eigen bedrijfsnamen op de kaart (Pesca,
      // Van Puffelen, willekeurige lunchtenten uit de buurt). Die trokken
      // meer aandacht dan onze eigen pinnen, en ze bleven staan als je
      // filterde: dan zag je vier gefilterde winkels tussen twintig
      // Google-labels die er niets mee te maken hadden. Alle POI-labels en
      // bedrijfsicoontjes dus uit; straatnamen, water en parken blijven,
      // want daarop orienteer je je.
      styles: [
        { featureType: 'poi', elementType: 'labels', stylers: [{ visibility: 'off' }] },
        { featureType: 'poi.business', stylers: [{ visibility: 'off' }] },
        { featureType: 'transit', elementType: 'labels.icon', stylers: [{ visibility: 'off' }] },
      ],
      // Geen Google-POI's meer aanklikbaar: er valt niets meer op te
      // klikken dat niet van ons is.
      clickableIcons: false,
    });

    // Bij hoeveel zichtbare pinnen zetten we de naam erbij? Met alles aan
    // (ruim honderd pinnen op een straat) wordt dat een onleesbare kluwen,
    // want Google schuift labels niet uit elkaar. Op verzoek van Nora staat
    // de drempel op 25, zodat ook de grootste categorie (Restaurants, 22
    // zaken) namen krijgt: daar overlappen ze soms, en dat is bewust
    // geaccepteerd boven geen namen hebben.
    var LABEL_DREMPEL = 25;

    function labelVoor(naam) {
      return {
        text: naam,
        className: 'kaart-pin-label',
        color: '#14342a',
        fontSize: '12px',
        fontWeight: '600',
      };
    }

    function werkLabelsBij() {
      var zichtbaar = markers.filter(function (m) { return m.getVisible(); });
      var aan = zichtbaar.length <= LABEL_DREMPEL;
      markers.forEach(function (m) {
        m.setLabel(aan && m.getVisible() ? labelVoor(m.ondernemerNaam) : null);
      });
    }

    // Het infokaartje bij een klik op een pin: dezelfde informatie die je op
    // Google zelf zou zien (naam, adres, of het nu open is, de openingstijden
    // van de hele week, en een route- en Google Maps-link), samengesteld uit
    // places.json. Dat is Google's eigen data, dagelijks opgehaald door de
    // "Places verversen"-workflow, dus bij een klik hoeft er niets extra
    // opgevraagd te worden en blijft de kaart snel.
    var DAGEN = [
      { sleutel: 'ma', label: 'Maandag' },
      { sleutel: 'di', label: 'Dinsdag' },
      { sleutel: 'wo', label: 'Woensdag' },
      { sleutel: 'do', label: 'Donderdag' },
      { sleutel: 'vr', label: 'Vrijdag' },
      { sleutel: 'za', label: 'Zaterdag' },
      { sleutel: 'zo', label: 'Zondag' },
    ];
    // getDay(): 0 = zondag. Onze sleutels beginnen bij maandag.
    var DAG_INDEX = ['zo', 'ma', 'di', 'wo', 'do', 'vr', 'za'];

    function nuOpen(urenVandaag) {
      if (!urenVandaag) return null;
      var nu = new Date();
      var minutenNu = nu.getHours() * 60 + nu.getMinutes();
      // Een dag kan meerdere blokken hebben ("09:00-13:00, 14:00-18:00").
      var blokken = urenVandaag.split(',');
      for (var i = 0; i < blokken.length; i++) {
        var d = blokken[i].trim().split('-');
        if (d.length !== 2) continue;
        var van = d[0].split(':');
        var tot = d[1].split(':');
        if (van.length !== 2 || tot.length !== 2) continue;
        var start = parseInt(van[0], 10) * 60 + parseInt(van[1], 10);
        var eind = parseInt(tot[0], 10) * 60 + parseInt(tot[1], 10);
        // Sluiten na middernacht (bv. 17:00-01:00) telt door in de nacht.
        if (eind <= start) eind += 24 * 60;
        if (minutenNu >= start && minutenNu < eind) return true;
        if (minutenNu + 24 * 60 >= start && minutenNu + 24 * 60 < eind) return true;
      }
      return false;
    }

    function infoKaartje(item) {
      var wrap = document.createElement('div');
      wrap.className = 'kaart-info';

      var titel = document.createElement('a');
      titel.className = 'kaart-info__naam';
      titel.href = item.href;
      titel.textContent = item.naam;
      wrap.appendChild(titel);

      if (item.adres) {
        var adres = document.createElement('p');
        adres.className = 'kaart-info__adres';
        adres.textContent = item.adres;
        wrap.appendChild(adres);
      }

      if (item.uren) {
        var vandaagSleutel = DAG_INDEX[new Date().getDay()];
        var vandaag = item.uren[vandaagSleutel];
        var open = nuOpen(vandaag);
        var status = document.createElement('p');
        status.className = 'kaart-info__status';
        if (open === true) {
          status.textContent = 'Nu open';
          status.classList.add('is-open');
        } else if (open === false) {
          status.textContent = vandaag ? 'Nu gesloten' : 'Vandaag gesloten';
          status.classList.add('is-dicht');
        }
        if (status.textContent) wrap.appendChild(status);

        var tabel = document.createElement('table');
        tabel.className = 'kaart-info__uren';
        DAGEN.forEach(function (dag) {
          var rij = tabel.insertRow();
          if (dag.sleutel === vandaagSleutel) rij.className = 'is-vandaag';
          rij.insertCell().textContent = dag.label;
          rij.insertCell().textContent = item.uren[dag.sleutel] || 'gesloten';
        });
        wrap.appendChild(tabel);
      }

      var acties = document.createElement('p');
      acties.className = 'kaart-info__acties';
      var bestemming = encodeURIComponent(item.adres || item.naam);
      var route = document.createElement('a');
      route.href = 'https://www.google.com/maps/dir/?api=1&destination=' + bestemming +
        (item.placeId ? '&destination_place_id=' + item.placeId : '');
      route.target = '_blank';
      route.rel = 'noopener';
      route.textContent = 'Route';
      acties.appendChild(route);
      var opGoogle = document.createElement('a');
      opGoogle.href = 'https://www.google.com/maps/search/?api=1&query=' + bestemming +
        (item.placeId ? '&query_place_id=' + item.placeId : '');
      opGoogle.target = '_blank';
      opGoogle.rel = 'noopener';
      opGoogle.textContent = 'Op Google Maps';
      acties.appendChild(opGoogle);
      var eigen = document.createElement('a');
      eigen.href = item.href;
      eigen.textContent = 'Naar de pagina';
      acties.appendChild(eigen);
      wrap.appendChild(acties);

      return wrap;
    }

    var bounds = new google.maps.LatLngBounds();
    var infoWindow = new google.maps.InfoWindow();
    var markers = [];

    items.forEach(function (item) {
      var positie = { lat: item.lat, lng: item.lng };
      var iconUrl = iconMap[item.categorie] || iconMap.__standaard__;
      var marker = new google.maps.Marker({
        position: positie,
        map: map,
        title: item.naam,
        icon: iconUrl
          ? {
              url: iconUrl,
              scaledSize: new google.maps.Size(30, 30),
              anchor: new google.maps.Point(15, 15),
              // Het label komt onder de cirkel te hangen i.p.v. er middenin.
              labelOrigin: new google.maps.Point(15, 36),
            }
          : undefined,
      });
      marker.addListener('click', function () {
        infoWindow.setContent(infoKaartje(item));
        infoWindow.open(map, marker);
      });
      marker.categorie = item.categorie;
      marker.tweedeLabel = item.tweedeLabel || null;
      marker.ondernemerNaam = item.naam;
      markers.push(marker);
      bounds.extend(positie);
    });

    map.fitBounds(bounds, 40);
    werkLabelsBij();

    // Reageert op dezelfde categorie-filterknoppen als de kaartjes-grid (of
    // de chips in de CTA-sectie op de homepage) eronder — apart luisterend
    // event i.p.v. de bestaande listener aanpassen, zodat kaart en
    // grid/chips onafhankelijk van elkaar blijven werken.
    var filterBar = document.querySelector('[data-filters]');
    filterBar && filterBar.addEventListener('click', function (e) {
      var btn = e.target.closest('.filter-btn');
      if (!btn) return;
      var cat = btn.dataset.cat;
      var zichtbareBounds = new google.maps.LatLngBounds();
      var heeftZichtbare = false;
      markers.forEach(function (marker) {
        var zichtbaar = cat === 'alle' || marker.categorie === cat || marker.tweedeLabel === cat;
        marker.setVisible(zichtbaar);
        if (zichtbaar) {
          zichtbareBounds.extend(marker.getPosition());
          heeftZichtbare = true;
        }
      });
      werkLabelsBij();
      if (heeftZichtbare) map.fitBounds(zichtbareBounds, 40);
    });
  }
  window.initOndernemersKaart = initOndernemersKaart;
</script>

<style>
  /* Verhuisd hierheen vanuit de ondernemers-overzichtspagina's — Astro's
     scoped CSS matcht alleen elementen die in hetzelfde bestand als de
     <style> staan, dus CSS op de paginas zelf zou dit element hier niet
     raken. */
  .locatie-kaart {
    position: relative;
    aspect-ratio: 16/6;
    min-height: 220px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--color-border);
    margin: var(--space-md) 0;
  }
  /* CTA-variant op de homepage: donkere sectie, dus lichte rand i.p.v.
     --color-border, en dezelfde 4/3-verhouding als de oude platte
     iframe-embed die dit vervangt. */
  .locatie-kaart--cta {
    aspect-ratio: 4/3;
    margin: 0;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.15);
  }
  /* Zone-variant: in het groene vlak op de ondernemerspagina, naast de
     filters. Staat daar op halve breedte, dus vierkanter dan de brede strook
     die hij eerst boven de pagina was, en met een lichte rand omdat de
     ondergrond donker is. Vult de hoogte van zijn kolom. */
  .locatie-kaart--zone {
    aspect-ratio: auto;
    height: 100%;
    min-height: 420px;
    margin: 0;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18);
  }
</style>

<style is:global>
  /* Google zet dit label-div zelf in de kaart, buiten onze component-scope,
     vandaar is:global. Witte gloed eromheen zodat de naam leesbaar blijft
     boven straten, water en gebouwen, zonder een blok achtergrond dat de
     kaart dichtsmeert. */
  .kaart-pin-label {
    text-shadow:
      0 0 3px #fff, 0 0 3px #fff, 0 0 3px #fff, 0 0 6px #fff;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  /* Het infokaartje in de Google-InfoWindow. Ook dit zet Google buiten onze
     component-scope in de DOM, vandaar opnieuw is:global. Onze eigen
     huisstijl, met de indeling die mensen van een Google-kaartje kennen:
     naam, adres, open of dicht, de week, en de acties eronder. */
  .kaart-info {
    font-family: inherit;
    min-width: 210px;
    max-width: 260px;
    padding-right: 4px;
  }
  .kaart-info__naam {
    display: block;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.25;
    color: #14342a;
    text-decoration: none;
  }
  .kaart-info__naam:hover,
  .kaart-info__naam:focus-visible {
    text-decoration: underline;
  }
  .kaart-info__adres {
    margin: 2px 0 6px;
    font-size: 0.8125rem;
    color: #5b6b63;
  }
  .kaart-info__status {
    margin: 0 0 6px;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .kaart-info__status.is-open { color: #1b7a4b; }
  .kaart-info__status.is-dicht { color: #a1443a; }
  .kaart-info__uren {
    border-collapse: collapse;
    font-size: 0.75rem;
    color: #5b6b63;
    margin-bottom: 8px;
  }
  .kaart-info__uren td {
    padding: 1px 10px 1px 0;
    white-space: nowrap;
  }
  .kaart-info__uren tr.is-vandaag td {
    color: #14342a;
    font-weight: 600;
  }
  .kaart-info__acties {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin: 0;
    font-size: 0.8125rem;
  }
  .kaart-info__acties a {
    color: #1b3b2f;
    text-decoration: underline;
  }
</style>

<script is:inline define:vars={{ houderId: 'ondernemers-kaart' }}>
  // Het Maps-script wordt hier pas ingeladen, en alleen na toestemming.
  window.rgExternLaden({
    houderId: houderId,
    uitleg: 'De kaart komt van Google. Als je hem laadt, gaat je IP-adres naar Google.',
    knop: 'Kaart laden',
    laad: function () {
      var s = document.createElement('script');
      s.async = true;
      s.src =
        'https://maps.googleapis.com/maps/api/js?key=AIzaSyCJ91Qc-ndwZUT2VVnHXbT3V--IN2KDmEQ' +
        '&callback=initOndernemersKaart&loading=async';
      document.head.append(s);
    },
  });
</script>

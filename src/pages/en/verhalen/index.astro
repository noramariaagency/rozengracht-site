---
// "Verhalen"/"Stories" is renamed to "Historie"/"History" — see
// ../../verhalen/index.astro for why this is a static redirect page instead
// of an astro.config.mjs redirect.
import { getRelativeLocaleUrl } from 'astro:i18n';

const doel = getRelativeLocaleUrl('en', 'historie/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${doel}`} />
    <link rel="canonical" href={doel} />
    <meta name="robots" content="noindex" />
    <title>Stories is now History</title>
  </head>
  <body>
    <p>This page is now called <a href={doel}>History</a>.</p>
    <script define:vars={{ doel }}>
      window.location.replace(doel);
    </script>
  </body>
</html>

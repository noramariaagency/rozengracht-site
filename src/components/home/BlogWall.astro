---
// De homepage is een blog, geen nieuwswebsite: dit is de ene, ongetitelde
// "wall" direct onder de bereikbaarheidsbalk en de event-highlight. Geen
// aparte "Nieuws & updates"- of "Uitgelicht"-koppen meer (feedback: "we zijn
// geen nieuws en updates website meer, ook niet uitgelicht, we zijn een
// blog") — nieuws (incl. bereikbaarheid) en historie-verhalen staan hier
// gemixed, gesorteerd op publicatiedatum, in wisselende kaartformaten naar
// het voorbeeld van beethovenstraat.nl. Ondernemers komen hier niet als
// eigen kaart in: die worden gedekt doordat blogartikelen naar ze verwijzen
// (contentwerk van topic 04), niet doordat wij hun profiel in de wall
// trekken.
import ContentCard from '../ContentCard.astro';
import { getCollection, getEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { nieuwsToItem, verhaalToItem, resolveFoto } from '../../lib/items';
import type { FeedItem } from '../../lib/items';
import type { Lang } from '../../lib/i18n';

// Cap op de homepage — geen eindeloze lijst hier, de volledige, filterbare
// lijst staat op /lezen/.
const AANTAL = 12;

interface Props {
  lang?: Lang;
}
const { lang = 'nl' } = Astro.props;

const alleNieuwsRuw = (await getCollection('nieuws')).sort(
  (a, b) => b.data.datum.valueOf() - a.data.datum.valueOf()
);
const nieuwsItems = await Promise.all(
  alleNieuwsRuw.map(async (n) => {
    const ondernemer = n.data.gerelateerde_ondernemer ? await getEntry(n.data.gerelateerde_ondernemer) : null;
    const foto = await resolveFoto(n.data.foto, 640, n.data.fotoFocus);
    return nieuwsToItem(n, ondernemer, foto, lang);
  })
);

// Historie-verhalen hebben geen publicatiedatum in het schema (alleen een
// vrije "periode"-tekst als "1913 tot nu"), dus kunnen niet echt
// chronologisch tussen het nieuws gesorteerd worden. Interim oplossing tot
// dat veld er is (verzoek aan topic 01 staat in CLAIMS.md): om de vaste
// paar nieuwsartikelen één verhaal ertussen zetten, in een stabiele
// (niet-willekeurige) volgorde — zo komt elk verhaal een keer langs zonder
// een fictieve publicatiedatum te verzinnen.
const alleVerhalenRuw = await getCollection('verhalen');
const verhalenItems = await Promise.all(
  alleVerhalenRuw.map(async (v) => {
    const ondernemer = v.data.gerelateerde_ondernemer ? await getEntry(v.data.gerelateerde_ondernemer) : null;
    const foto = await resolveFoto(v.data.foto, 640, v.data.fotoFocus);
    return verhaalToItem(v, ondernemer, foto, lang);
  })
);

// Evenredig verdelen over de hele wall i.p.v. een vaste "elke 4e"-interval:
// bij bv. 8 nieuwsartikelen en 9 verhalen zou een vaste interval de helft
// van de verhalen vooraan interleaven en de rest in één keer achteraan
// dumpen. Op elk punt in de nieuws-reeks ligt hier vast hoeveel verhalen er
// tot dan toe hadden moeten volgen (verhoudingsgewijs), en wordt het
// verschil ingehaald.
const wall: FeedItem[] = [];
let verhaalIndex = 0;
nieuwsItems.forEach((item, i) => {
  wall.push(item);
  const verwacht = verhalenItems.length === 0 ? 0 : Math.round(((i + 1) / nieuwsItems.length) * verhalenItems.length);
  while (verhaalIndex < verwacht) {
    wall.push(verhalenItems[verhaalIndex]);
    verhaalIndex += 1;
  }
});
// Restje voor de zekerheid (bv. als nieuwsItems leeg is) alsnog toevoegen
// i.p.v. stilzwijgend laten vallen.
wall.push(...verhalenItems.slice(verhaalIndex));

// De homepage toont alleen de eerste AANTAL — "9 of 12 met een 'meer'"
// i.p.v. de hele lijst hier al dumpen. Het volledige, filterbare archief
// staat op /lezen/.
const getoond = wall.slice(0, AANTAL);

const TEKST: Record<Lang, string> = {
  nl: 'Meer artikelen',
  en: 'More articles',
};

// Kaartformaat: hoe meer tekst het artikel echt heeft (rawLength, dus vóór
// de ~150-tekens-afkap van excerpt), hoe groter het kaartje — dezelfde
// gedachte als op beethovenstraat.nl, waar de kaartjes ook niet allemaal
// even groot zijn. Het nieuwste artikel is altijd 'lg' als duidelijke
// "lead"-positie bovenaan de wall.
function formaat(item: FeedItem, index: number): 'lg' | 'md' | 'sm' {
  if (index === 0) return 'lg';
  if (item.rawLength > 500) return 'lg';
  if (item.rawLength > 200) return 'md';
  return 'sm';
}
---
<div class="container">
  <div class="blog-wall">
    {getoond.map((item, i) => (
      <div class={`wall-item wall-item-${formaat(item, i)} reveal-item`}>
        <ContentCard item={item} variant="feature" size={formaat(item, i)} />
      </div>
    ))}
  </div>
  <a class="meer-link" href={getRelativeLocaleUrl(lang, 'lezen')}>{TEKST[lang]} &rarr;</a>
</div>

<style>
  .blog-wall {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-flow: dense;
    align-items: start;
    gap: 28px;
    padding: 32px 0 40px;
  }
  .meer-link {
    display: block;
    width: fit-content;
    margin: 0 auto 56px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--green-deep);
    border-bottom: 1px solid var(--rose);
    padding-bottom: 2px;
    text-decoration: none;
  }
  .wall-item-lg { grid-column: span 4; }
  .wall-item-md { grid-column: span 3; }
  .wall-item-sm { grid-column: span 2; }
  @media (max-width: 900px) {
    .wall-item-lg, .wall-item-md, .wall-item-sm { grid-column: span 6; }
  }
  @media (min-width: 901px) and (max-width: 1150px) {
    .wall-item-sm { grid-column: span 3; }
  }

  .reveal-item {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .reveal-item.is-visible { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    .reveal-item { opacity: 1; transform: none; transition: none; }
  }
</style>

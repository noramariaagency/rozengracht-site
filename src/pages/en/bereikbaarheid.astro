---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { actueleUpdates } from '../../data/bereikbaarheid-updates';
import type { Lang } from '../../lib/i18n';

const lang: Lang = 'en';

const routes = [
  {
    titel: 'On foot',
    icoon: '<path d="M12 21s-7-5.4-7-11a7 7 0 1 1 14 0c0 5.6-7 11-7 11Z" /><circle cx="12" cy="10" r="2.5" />',
    tekst: 'From Dam Square: take Raadhuisstraat west. Past the Westerkerk and Westermarkt it runs straight into the Rozengracht, about a 10-minute walk.',
  },
  {
    titel: 'By bike',
    icoon: '<circle cx="18.5" cy="17.5" r="3.5" /><circle cx="5.5" cy="17.5" r="3.5" /><circle cx="15" cy="5" r="1" /><path d="M12 17.5V14l-3-3 4-3 2 3h2" />',
    tekst: 'The Rozengracht has its own cycle lane in both directions and connects well to the Prinsengracht, which crosses the street at the Westermarkt.',
  },
  {
    titel: 'By car',
    icoon: '<rect width="18" height="18" x="3" y="3" rx="2" /><path d="M9 17V7h4a3 3 0 0 1 0 6H9" />',
    tekst: 'Parking on the Rozengracht itself is limited and paid. Parking garage Marnix (Marnixstraat 250) is the nearest garage.',
  },
  {
    titel: 'By public transport',
    icoon: '<path d="M8 6v6" /><path d="M15 6v6" /><path d="M2 12h19.6" /><path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4a2 2 0 0 0-2 2v10h3" /><circle cx="7" cy="18" r="2" /><circle cx="16" cy="18" r="2" />',
    tekst: 'Trams 13 and 17 stop on the Rozengracht itself, with stops at the Westermarkt and at the Marnixstraat.',
  },
];

const updates = actueleUpdates();

function formatDatum(d: Date) {
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---
<BaseLayout title="Getting there" description="How to reach the Rozengracht in Amsterdam: on foot, by bike, by car or by public transport, plus current updates about roadworks and events." lang={lang}>
  <span class="eyebrow">The street</span>
  <h1>Getting there</h1>
  <p class="intro">The Rozengracht runs east to west through the Jordaan and is easy to reach from every direction.</p>

  <section class="updates-section">
    <h2>Current updates</h2>
    {updates.length > 0 ? (
      <div class="updates-list">
        {updates.map((update) => (
          <div class="update-card">
            <div class="update-periode">
              {formatDatum(update.vanaf)}{update.tot ? ` – ${formatDatum(update.tot)}` : ' – until further notice'}
            </div>
            <h3>{update.titel_en}</h3>
            <p>{update.tekst_en}</p>
          </div>
        ))}
      </div>
    ) : (
      <p class="geen-updates">Nothing to report right now: the Rozengracht is accessible as usual.</p>
    )}
  </section>

  <div class="routes-grid">
    {routes.map((route) => (
      <div class="route-card">
        <div class="route-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={route.icoon} />
        </div>
        <h2>{route.titel}</h2>
        <p>{route.tekst}</p>
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  .eyebrow {
    display: block;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rose-deep);
    font-weight: 600;
    margin-bottom: 6px;
  }
  .intro { color: var(--color-muted); max-width: 560px; margin-top: var(--space-xs); }

  .routes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-md);
    margin: var(--space-xl) 0 var(--space-lg);
  }
  .route-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-md);
  }
  .route-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--rose-tint);
    color: var(--green-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-sm);
  }
  .route-icon svg { width: 22px; height: 22px; }
  .route-card h2 { font-size: 1.05rem; margin-bottom: 6px; }
  .route-card p { font-size: 0.9rem; color: var(--ink-soft); margin: 0; }

  .updates-section { margin-top: var(--space-lg); }
  .updates-section h2 { font-size: 1.3rem; margin-bottom: var(--space-md); }
  .updates-list { display: flex; flex-direction: column; gap: var(--space-sm); }
  .update-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--ochre);
    border-radius: var(--radius);
    padding: var(--space-md);
  }
  .update-periode {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ochre);
    margin-bottom: 8px;
  }
  .update-card h3 { font-size: 1.05rem; margin-bottom: 6px; }
  .update-card p { font-size: 0.92rem; color: var(--ink-soft); margin: 0; }
  .geen-updates {
    color: var(--ink-soft);
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-md);
  }
</style>

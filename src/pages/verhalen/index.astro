---
// "Verhalen" is hernoemd naar "Historie" — deze pagina bestaat alleen nog om
// bezoekers en zoekmachines die de oude URL nog hebben (bladwijzer, oude
// zoekresultaten, externe links) door te sturen. Geen astro.config.mjs-
// redirect (dat bestand is gedeeld, gesloten gebied buiten topic 01 om) maar
// een losse statische pagina: dat werkt hetzelfde op een static build voor
// GitHub Pages, zonder een server nodig te hebben.
import { getRelativeLocaleUrl } from 'astro:i18n';

const doel = getRelativeLocaleUrl('nl', 'historie/');
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${doel}`} />
    <link rel="canonical" href={doel} />
    <meta name="robots" content="noindex" />
    <title>Verhalen is nu Historie</title>
  </head>
  <body>
    <p>Deze pagina heet nu <a href={doel}>Historie</a>.</p>
    <script define:vars={{ doel }}>
      window.location.replace(doel);
    </script>
  </body>
</html>

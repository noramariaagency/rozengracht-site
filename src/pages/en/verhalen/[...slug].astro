---
// Per-story redirect: every old /en/verhalen/<slug>/ URL keeps existing as a
// small redirect page to the same <slug> under /en/historie/.
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';

export async function getStaticPaths() {
  const verhalen = await getCollection('verhalen');
  return verhalen.map((entry) => ({
    params: { slug: entry.slug },
  }));
}

const { slug } = Astro.params;
const doel = getRelativeLocaleUrl('en', `historie/${slug}/`);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${doel}`} />
    <link rel="canonical" href={doel} />
    <meta name="robots" content="noindex" />
    <title>Stories is now History</title>
  </head>
  <body>
    <p>This story now lives under <a href={doel}>History</a>.</p>
    <script define:vars={{ doel }}>
      window.location.replace(doel);
    </script>
  </body>
</html>

---
// Doorverwijzing per verhaal: elke oude /verhalen/<slug>/-URL blijft bestaan
// als kleine redirectpagina naar dezelfde <slug> onder /historie/. Zie
// verhalen/index.astro voor waarom dit geen astro.config.mjs-redirect is.
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';

export async function getStaticPaths() {
  const verhalen = await getCollection('verhalen');
  return verhalen.map((entry) => ({
    params: { slug: entry.slug },
  }));
}

const { slug } = Astro.params;
const doel = getRelativeLocaleUrl('nl', `historie/${slug}/`);
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${doel}`} />
    <link rel="canonical" href={doel} />
    <meta name="robots" content="noindex" />
    <title>Verhalen is nu Historie</title>
  </head>
  <body>
    <p>Dit verhaal staat nu onder <a href={doel}>Historie</a>.</p>
    <script define:vars={{ doel }}>
      window.location.replace(doel);
    </script>
  </body>
</html>

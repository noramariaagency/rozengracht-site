---
// Nette vervanger voor een ontbrekende foto: een categorie-icoon op een
// zachte merkkleur-achtergrond, i.p.v. een grijs vlak of "foto volgt".
// Vult altijd de volledige ouder (position: absolute, inset: 0) — de
// aanroepende pagina bepaalt de vorm/aspect-ratio via een positioned
// container.
import { categorieIconen, standaardIcoon } from '../lib/categorieen';

interface Props {
  categorie: string;
}

const { categorie } = Astro.props;
const icoon = categorieIconen[categorie] ?? standaardIcoon;
---
<div class="foto-fallback" aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" set:html={icoon} />
</div>

<style>
  .foto-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Zachter dan de vorige versie (volle --rose-tint + --green-deep op
       0.55 opacity): dat vlak trok evenveel aandacht als een echte foto.
       Nu bijna monochroom crème, icoon in de gedempte inkttint, lagere
       opacity — een rustige achtergrond die wegvalt zodra er wél een foto
       staat, in plaats van ermee te concurreren. */
    background: linear-gradient(135deg, var(--cream), var(--cream-card));
    color: var(--ink-soft);
    opacity: 0.38;
  }
  .foto-fallback svg {
    width: 34%;
    height: 34%;
    max-width: 64px;
    max-height: 64px;
  }
</style>

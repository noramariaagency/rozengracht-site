---
// Homepage als magazine-landing (topic 03): het nieuws/de artikelen zijn de
// hoofdmoot ("home wordt een blog"), ondernemers komen hier niet als lijst
// in — dat blijft voorbehouden aan /ondernemers. Alle secties zitten als
// losse, herbruikbare bouwstenen in src/components/home/, zodat deze pagina
// en en/index.astro hetzelfde opbouwen zonder logica te dupliceren.
import BaseLayout from '../layouts/BaseLayout.astro';
import BereikbaarheidBar from '../components/home/BereikbaarheidBar.astro';
import NieuwsSectie from '../components/home/NieuwsSectie.astro';
import Uitgelicht from '../components/home/Uitgelicht.astro';
import InstagramFeed from '../components/home/InstagramFeed.astro';
import NieuwOpDeRozengracht from '../components/home/NieuwOpDeRozengracht.astro';
import AanHetWoord from '../components/home/AanHetWoord.astro';
import OndernemersCta from '../components/home/OndernemersCta.astro';
import BizSectie from '../components/home/BizSectie.astro';
import type { Lang } from '../lib/i18n';

const lang: Lang = 'nl';
---
<BaseLayout title="Home" fullBleed lang={lang}>
  <!-- Visueel verborgen h1: de homepage heeft geen zichtbare hero-titel in het
       ontwerp, maar elke pagina heeft een <h1> nodig voor kopstructuur/SEO. -->
  <h1 class="visually-hidden">BIZ Ondernemersvereniging Rozengracht, Amsterdam</h1>

  <BereikbaarheidBar lang={lang} />
  <NieuwsSectie lang={lang} />
  <Uitgelicht lang={lang} />

  <!-- ZONE 2: ONTDEK — volledig donkergroen, inverse van de lichte
       nieuws/magazine-zone hierboven. -->
  <section class="section ontdek-zone" id="ontdek">
    <div class="container">
      <div class="ontdek-intro">
        <span class="eyebrow">Andere kant van de straat</span>
        <h2>Ontdek</h2>
      </div>

      <InstagramFeed lang={lang} />

      <div class="ondernemers-layout" id="ondernemers">
        <NieuwOpDeRozengracht lang={lang} />
        <AanHetWoord lang={lang} />
      </div>

      <OndernemersCta lang={lang} />
      <BizSectie lang={lang} />
    </div>
  </section>
</BaseLayout>

<style>
  .ontdek-zone { background: var(--green-deep); padding: 88px 0 92px; position: relative; z-index: 5; }
  .ontdek-zone h2, .ontdek-zone h3 { color: #fbfaf7; }
  .ontdek-intro { margin-bottom: 32px; }
  .ontdek-intro .eyebrow {
    display: block;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rose);
    font-weight: 600;
    margin-bottom: 6px;
  }
  .sub-section { margin-top: 76px; }
  .ondernemers-layout { margin-top: 76px; display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start; }
  /* "Nieuw op de Rozengracht" verdwijnt volledig zodra er niets nieuws is
     (zie NieuwOpDeRozengracht.astro) — blijft dan alleen "Aan het woord"
     over. :only-child laat die dan de volle breedte innemen i.p.v. een
     halflege grid met een gat rechts. */
  .ondernemers-layout > :only-child { grid-column: 1 / -1; }
  @media (max-width: 900px) {
    .ondernemers-layout { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  // Scroll reveal: gestaggerde fade+lift zodra content in beeld komt. Blijft
  // op paginaniveau (i.p.v. per component) omdat de observer gewoon alle
  // .reveal-item's op de pagina afgaat, ongeacht welke component ze rendert.
  var revealItems = document.querySelectorAll('.reveal-item');
  var revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
  );

  var seenParents = new Map();
  revealItems.forEach((el) => {
    var parent = el.parentElement;
    var idx = seenParents.get(parent) || 0;
    el.style.transitionDelay = Math.min(idx * 70, 350) + 'ms';
    seenParents.set(parent, idx + 1);
    revealObserver.observe(el);
  });
</script>

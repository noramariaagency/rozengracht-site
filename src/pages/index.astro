---
import BaseLayout from '../layouts/BaseLayout.astro';
import FotoFallback from '../components/FotoFallback.astro';
import OndernemersKaart from '../components/OndernemersKaart.astro';
import plekken from '../data/places.json';
import ContentCard from '../components/ContentCard.astro';
import { getCollection, getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCategorieLabels } from '../lib/categorieen';
import { nieuwsToItem, eventToItem, resolveFoto } from '../lib/items';
import type { Lang } from '../lib/i18n';

const lang: Lang = 'nl';

// --- Nieuws & updates: echte content uit de nieuws-collection, genormaliseerd
// naar het gedeelde kaart-model (zie src/lib/items.ts) zodat dit blok exact
// dezelfde <ContentCard /> gebruikt als de nieuwspagina en de events hieronder. ---
const alleNieuwsRuw = (await getCollection('nieuws')).sort(
  (a, b) => b.data.datum.valueOf() - a.data.datum.valueOf()
);
const nieuwsItems = await Promise.all(
  alleNieuwsRuw.map(async (n) => {
    const ondernemer = n.data.gerelateerde_ondernemer ? await getEntry(n.data.gerelateerde_ondernemer) : null;
    const foto = await resolveFoto(n.data.foto, 640, n.data.fotoFocus);
    return nieuwsToItem(n, ondernemer, foto, lang);
  })
);
const [featureNieuwsItem, ...restNieuwsItems] = nieuwsItems;
const compactNieuwsItems = restNieuwsItems.slice(0, 3);

// --- Events: nu een echte content-collection i.p.v. hardcoded voorbeelddata.
// "Binnenkort" vs. "Terugblik" wordt afgeleid van de datum t.o.v. vandaag —
// zelfde aanpak als de bereikbaarheidsupdates, dus nooit een handmatig vlag
// dat kan gaan afwijken van de werkelijkheid. ---
const vandaag = new Date();
const alleEventsRuw = await getCollection('events');
const alleEventsItems = await Promise.all(
  alleEventsRuw.map(async (e) => {
    const ondernemer = e.data.gerelateerde_ondernemer ? await getEntry(e.data.gerelateerde_ondernemer) : null;
    // Verplichte koppeling: elk event verwijst naar het nieuwsartikel met de
    // volledige uitleg, en het kaartje linkt daar ook naartoe (zie eventToItem).
    const nieuwsEntry = await getEntry(e.data.gerelateerd_nieuwsbericht);
    const foto = await resolveFoto(e.data.foto, 640, e.data.fotoFocus);
    return { entry: e, item: eventToItem(e, nieuwsEntry, ondernemer, foto, lang) };
  })
);
const binnenkortEvents = alleEventsItems
  .filter(({ entry }) => (entry.data.datum_tot ?? entry.data.datum) >= vandaag)
  .sort((a, b) => a.item.sortValue - b.item.sortValue)
  .map(({ item }) => item);
const terugblikEvents = alleEventsItems
  .filter(({ entry }) => (entry.data.datum_tot ?? entry.data.datum) < vandaag)
  .sort((a, b) => b.item.sortValue - a.item.sortValue)
  .map(({ item }) => item);

// --- Wie kwam er laatst bij: alléén ondernemers met een bekende openingsdatum
// (nieuw_sinds), meest recent eerst, en maximaal 5 — dit is bewust een korte
// "vers binnen"-strip, geen volledig overzicht (dat staat al op /ondernemers).
// Ondernemers zonder bekende datum tonen we hier niet: die datum verzinnen zou
// een orde suggereren die we niet kunnen onderbouwen. -->
const categorieLabels = getCategorieLabels(lang);
const alleOndernemers = await getCollection(
  'ondernemers',
  ({ data }) => data.status !== 'overslaan' && data.status !== 'geen-interesse'
);
const ondernemersStripRuw = await Promise.all(
  alleOndernemers
    .filter((o) => o.data.nieuw_sinds)
    .map(async (o) => {
      // Foto is optioneel — zonder foto valt de kaart terug op FotoFallback.
      const foto = o.data.fotos[0]
        ? await getImage({ src: o.data.fotos[0], width: 360, height: 360 })
        : null;
      return {
        slug: o.slug,
        naam: o.data.naam,
        categorie: o.data.categorie,
        categorieLabel: categorieLabels[o.data.categorie] ?? o.data.categorie,
        foto: foto?.src ?? null,
        nieuwSinds: o.data.nieuw_sinds,
      };
    })
);
const ondernemersStrip = ondernemersStripRuw
  .sort((a, b) => b.nieuwSinds.valueOf() - a.nieuwSinds.valueOf())
  .slice(0, 5);

// --- Ondernemers spreken: één citaat per ondernemer die er een heeft
// opgegeven, client-side willekeurig gekozen (zie <script> onderaan) zodat
// niet iedereen bij elk bezoek dezelfde ondernemer ziet uitgelicht. ---
const citaten = alleOndernemers
  .filter((o) => o.data.quote_nl)
  .map((o) => ({ naam: o.data.naam, quote: o.data.quote_nl }));

const categorieen = Object.entries(categorieLabels);
// Kaart in de CTA-sectie hieronder: dezelfde ondernemers-locaties als
// op de ondernemers-overzichtspagina, alleen wie een bekende locatie
// heeft (uit places.json) krijgt een pin.
const kaartItems = alleOndernemers
  .map((o) => {
    const plek = plekken[o.slug];
    if (!plek || plek.lat == null || plek.lng == null) return null;
    // Sanity-check tegen een verkeerd gegokte Places-match (bv. een
    // gelijknamige zaak in een andere stad) — buiten een ruime bounding
    // box rond de Rozengracht negeren we de pin liever dan de hele kaart
    // (via fitBounds) helemaal uit te laten zoomen voor iedereen.
    if (plek.lat < 52.3 || plek.lat > 52.42 || plek.lng < 4.8 || plek.lng > 4.95) return null;
    return {
      slug: o.slug,
      naam: o.data.naam,
      categorie: o.data.categorie,
      lat: plek.lat,
      lng: plek.lng,
      href: getRelativeLocaleUrl(lang, `ondernemers/${o.slug}/`),
    };
  })
  .filter((x) => x !== null);

---
<BaseLayout title="Home" fullBleed lang={lang}>
  <!-- Visueel verborgen h1: de homepage heeft geen zichtbare hero-titel in het
       ontwerp, maar elke pagina heeft een <h1> nodig voor kopstructuur/SEO. -->
  <h1 class="visually-hidden">BIZ Ondernemersvereniging Rozengracht, Amsterdam</h1>

  <!-- Bereikbaarheidsbalk: alleen de headline over bereikbaarheid, geen
       ticker met andere onderwerpen erdoorheen. -->
  <div class="banner">
    <div class="container banner-inner">
      <span class="tag-pill">Bereikbaarheid</span>
      <span>De Rozengracht is voor auto en fiets goed bereikbaar, met parkeergelegenheid in de directe omgeving.</span>
      <a href={getRelativeLocaleUrl(lang, 'bereikbaarheid')}>Bekijk bereikbaarheid &rarr;</a>
    </div>
  </div>

  <!-- ZONE 1: NIEUWS & UPDATES -->
  <section class="section" id="nieuws">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">In de straat</span>
          <h2>Nieuws &amp; updates</h2>
        </div>
        <a class="see-all" href={getRelativeLocaleUrl(lang, 'nieuws')}>Alle artikelen &rarr;</a>
      </div>

      <div class="news-grid">
        {featureNieuwsItem && (
          <div class="reveal-item">
            <ContentCard item={featureNieuwsItem} variant="feature" />
          </div>
        )}
        <div class="side-col">
          {compactNieuwsItems.map((item) => (
            <div class="reveal-item">
              <ContentCard item={item} variant="compact" />
            </div>
          ))}
        </div>
      </div>

      <!-- Events: nu een echte content-collection (src/content/events) i.p.v.
           hardcoded voorbeelddata — "Binnenkort" vs. "Terugblik" volgt
           automatisch uit de datum t.o.v. vandaag. Zelfde <ContentCard />
           als Nieuws hierboven, alleen met het groene event-accent. -->
      <div class="sub-section" id="events">
        <div class="sub-head">
          <h3>Events</h3>
        </div>
        <div class="events-grid">
          <div>
            <div class="subhead">Binnenkort</div>
            {binnenkortEvents.length > 0 ? binnenkortEvents.map((item) => (
              <ContentCard item={item} variant="compact" />
            )) : <p class="placeholder-note">Nog geen aankomende events gepland.</p>}
          </div>
          <div>
            <div class="subhead">Terugblik</div>
            {terugblikEvents.length > 0 ? terugblikEvents.map((item) => (
              <ContentCard item={item} variant="compact" />
            )) : <p class="placeholder-note">Nog geen eerdere events om op terug te blikken.</p>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ZONE 2: ONTDEK — gewoon normaal scrollende sectie, geen scroll-jack of
       animatie meer. De "Ontdek"-intro + Instagram-feed staan hier gewoon
       statisch bovenaan. -->
  <section class="section ontdek-zone" id="ontdek">
    <div class="container">
      <div class="ontdek-intro">
        <span class="eyebrow">Andere kant van de straat</span>
        <h2>Ontdek</h2>
      </div>
      <!-- Live Instagram-feed via Behold (feed b5MxJrsKqRkOGMp7FFo0) i.p.v.
           de eerdere statische volg-kaart — de widget zelf (indeling, aantal
           kolommen, etc.) staat ingesteld in het Behold-dashboard. -->
      <div class="insta-feed">
        <a class="insta-volg-link" href="https://www.instagram.com/derozengracht.amsterdam/" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
          @derozengracht.amsterdam
        </a>
        <behold-widget feed-id="b5MxJrsKqRkOGMp7FFo0"></behold-widget>
      </div>

      <div class="sub-section" id="ondernemers">
        <div class="sub-head">
          <div>
            <h3>Wie kwam er laatst bij?</h3>
            <p class="sub-note">Nieuwe gezichten op de Rozengracht, zodra ze er zijn.</p>
          </div>
          <a class="see-all" href={getRelativeLocaleUrl(lang, 'ondernemers')}>Alle ondernemers &rarr;</a>
        </div>
        <div class="ondernemers-layout">
          <!-- Geen reveal-on-scroll op deze kaartjes: het zijn horizontaal
               scrollende items in .strip-scroll (overflow-x: auto), en de
               IntersectionObserver rekent horizontale clipping door een
               scrollbare ancestor mee. Kaartjes die nog buiten de
               horizontale scrollpositie staan, kruisen het viewport dus
               nooit en bleven daardoor permanent op opacity:0 staan. -->
          {ondernemersStrip.length > 0 ? (
            <div class="strip-scroll">
              {ondernemersStrip.map((o) => (
                <a class="maker-card" href={getRelativeLocaleUrl(lang, `ondernemers/${o.slug}`)}>
                  <div class="photo-wrap">
                    {o.foto ? (
                      <img class="photo" src={o.foto} alt={o.naam} width="360" height="360" loading="lazy" />
                    ) : (
                      <FotoFallback categorie={o.categorie} />
                    )}
                  </div>
                  <h4>{o.naam}</h4>
                  <div class="role">{o.categorieLabel}</div>
                </a>
              ))}
            </div>
          ) : (
            <p class="placeholder-note light">Nog geen ondernemers met een bekende openingsdatum.</p>
          )}

          <!-- Ondernemers spreken: 2 echte citaten van ondernemers,
               willekeurig gekozen bij elk bezoek (zie script onderaan). De
               eerste 2 citaten worden hier al server-side getoond, zodat er
               ook zonder JavaScript altijd iets staat — het script wisselt
               die daarna om, tenzij er 2 of minder citaten zijn. -->
          <div class="highlight-reel reveal-item">
            <span class="reel-label">Aan het woord</span>
            {citaten.length > 0 ? (
              <div class="reel-quotes" id="ondernemerQuotes">
                {citaten.slice(0, 2).map((citaat) => (
                  <div class="reel-quote" data-naam={citaat.naam}>
                    <blockquote>{citaat.quote}</blockquote>
                    <div class="who">{citaat.naam}</div>
                  </div>
                ))}
              </div>
            ) : (
              <p class="placeholder-note light">Nog geen citaten van ondernemers verzameld.</p>
            )}
          </div>
          <script type="application/json" id="ondernemer-quotes" set:html={JSON.stringify(citaten)} />
        </div>
      </div>

      <div class="sub-section cta-card">
        <OndernemersKaart items={kaartItems} variant="cta" class="reveal-item" />
        <div class="cta-card-text reveal-item">
          <span class="eyebrow">Alles op één plek</span>
          <h2>Bekijk alle ondernemers op de kaart</h2>
          <div class="categories" data-filters role="group" aria-label="Filter op categorie">
            <button type="button" class="chip filter-btn is-active" data-cat="alle" aria-pressed="true">Alles</button>
            {categorieen.map(([key, label]) => (
              <button type="button" class="chip filter-btn" data-cat={key} aria-pressed="false">{label}</button>
            ))}
          </div>
          <a class="btn" href={getRelativeLocaleUrl(lang, 'ondernemers')}>Alle ondernemers bekijken</a>
        </div>
      </div>
    </div>

    <script is:inline>
      // is:inline i.p.v. een gehoiste module-script, zelfde reden als
      // elders in deze codebase. Zet alleen de actieve-knop-styling om;
      // het filteren van de kaart zelf gebeurt in OndernemersKaart.astro,
      // die naar dezelfde [data-filters] .filter-btn clicks luistert.
      var ctaFilterBar = document.querySelector('.cta-card [data-filters]');
      ctaFilterBar && ctaFilterBar.addEventListener('click', (e) => {
        var btn = e.target.closest('.filter-btn');
        if (!btn) return;
        ctaFilterBar.querySelectorAll('.filter-btn').forEach((b) => {
          b.classList.remove('is-active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');
      });
    </script>
  </section>
</BaseLayout>

<style>
  /* Bereikbaarheidsbalk: één statische regel, geen ticker/marquee. */
  .banner {
    background: var(--ochre);
    color: #fff7ee;
    font-size: 0.9rem;
  }
  .banner-inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    padding: 11px 0;
  }
  .tag-pill {
    font-family: var(--font-heading);
    font-weight: 700;
    font-style: italic;
    font-size: 0.8rem;
    background: rgba(255, 255, 255, 0.18);
    padding: 3px 10px;
    border-radius: 100px;
    flex-shrink: 0;
  }
  .banner-inner a { text-decoration: underline; text-underline-offset: 3px; font-weight: 500; color: #fff7ee; flex-shrink: 0; }

  /* Section shell */
  .section { position: relative; padding: 88px 0 12px; scroll-margin-top: var(--nav-height); }
  #events, #ondernemers { scroll-margin-top: var(--nav-height); }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 44px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .section-head h2 { font-size: 1.9rem; }
  .eyebrow {
    display: block;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rose-deep);
    font-weight: 600;
    margin-bottom: 6px;
  }
  .see-all {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--green-deep);
    border-bottom: 1px solid var(--rose);
    padding-bottom: 2px;
    white-space: nowrap;
    text-decoration: none;
  }
  .placeholder-note {
    font-size: 0.78rem;
    color: var(--ink-soft);
    font-style: italic;
    margin: 0 0 28px;
  }
  .placeholder-note.light { color: rgba(251, 250, 247, 0.6); margin: 14px 0 0; }

  .sub-section { margin-top: 76px; }
  .sub-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 26px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .sub-head h3 { font-size: 1.3rem; }

  /* Nieuws-grid: nu opgebouwd uit <ContentCard />, zie components/ContentCard.astro */
  .news-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 36px; }
  .news-grid .side-col { display: flex; flex-direction: column; gap: 20px; }
  @media (max-width: 760px) {
    .news-grid { grid-template-columns: 1fr; }
  }

  /* Events: ook opgebouwd uit <ContentCard variant="compact" /> */
  .events-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  @media (max-width: 760px) {
    .events-grid { grid-template-columns: 1fr; gap: 32px; }
  }
  .subhead {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--rose-deep);
    font-weight: 700;
    margin-bottom: 14px;
  }

  /* Reveal-on-scroll: fade+lift, gestaggerd. cubic-bezier i.p.v. bare "ease"
     voor een intentioneler gevoel (design-motion-principles: Jakub-register). */
  .reveal-item {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .reveal-item.is-visible { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    .reveal-item { opacity: 1; transform: none; transition: none; }
  }

  /* Ontdek-intro: gewone statische kop bovenaan de Ontdek-sectie, geen
     scroll-animatie meer. */
  .ontdek-intro { margin-bottom: 32px; }
  .ontdek-intro .eyebrow { color: var(--rose); }

  /* Ondernemers + quote-reel */
  .ondernemers-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start; }
  @media (max-width: 900px) {
    .ondernemers-layout { grid-template-columns: 1fr; }
  }
  .strip-scroll { display: flex; gap: 24px; overflow-x: auto; padding: 4px 4px 14px; scrollbar-width: thin; }
  .maker-card { flex: 0 0 180px; text-decoration: none; color: inherit; display: block; }
  .maker-card .photo-wrap {
    position: relative;
    aspect-ratio: 1/1;
    border-radius: 12px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.15);
    margin-bottom: 12px;
    overflow: hidden;
  }
  .maker-card .photo { width: 100%; height: 100%; border-radius: 0; object-fit: cover; }
  .maker-card .photo-wrap :global(.foto-fallback) { background: linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04)); color: #fbfaf7; }
  .maker-card h4 { font-size: 0.98rem; font-weight: 600; font-family: var(--font-heading); color: #fbfaf7; margin-bottom: 2px; }
  .maker-card .role { font-size: 0.78rem; color: rgba(251, 250, 247, 0.62); margin-bottom: 8px; }

  .highlight-reel {
    background: rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    padding: 22px 26px;
  }
  .reel-label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--rose); margin-bottom: 12px; display: block; }
  .reel-quotes { display: flex; flex-direction: column; gap: 20px; }
  .reel-quote { display: flex; flex-direction: column; transition: opacity 0.25s ease; }
  .reel-quotes .reel-quote + .reel-quote { padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, 0.14); }
  .reel-quote blockquote { font-family: var(--font-heading); font-style: italic; font-weight: 400; font-size: 1.1rem; line-height: 1.45; color: #fbfaf7; margin: 0 0 10px; }
  .reel-quote blockquote::before { content: '\201C'; }
  .reel-quote blockquote::after { content: '\201D'; }
  .reel-quote .who { font-size: 0.85rem; color: rgba(251, 250, 247, 0.6); font-weight: 600; }

  .sub-note { font-size: 0.85rem; color: rgba(251, 250, 247, 0.6); margin: 4px 0 0; max-width: 480px; }

  /* Instagram-feed: link naar het echte account boven de Behold-widget. */
  .insta-feed { display: flex; flex-direction: column; gap: 18px; }
  .insta-volg-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    font-weight: 600;
    font-size: 0.95rem;
    color: #fbfaf7;
    text-decoration: none;
    border-bottom: 1px solid rgba(251, 250, 247, 0.4);
    padding-bottom: 2px;
  }
  .insta-volg-link:hover { border-bottom-color: var(--rose); color: var(--rose); }
  .insta-volg-link svg { width: 20px; height: 20px; flex-shrink: 0; }

  /* CTA */
  .categories { display: flex; flex-wrap: wrap; gap: 10px; margin: 22px 0 34px; }
  .chip {
    font-size: 0.82rem;
    font-weight: 500;
    font-family: var(--font-body);
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.08);
    padding: 7px 15px;
    border-radius: 100px;
    color: #fbfaf7;
    cursor: pointer;
    touch-action: manipulation;
  }
  .chip.is-active {
    background: #fbfaf7;
    color: var(--green-deep);
    border-color: #fbfaf7;
  }
  .cta-card { display: grid; grid-template-columns: 2fr 1fr; gap: 40px; align-items: center; }
  @media (max-width: 760px) {
    .cta-card { grid-template-columns: 1fr; }
  }
  .cta-card h2 { font-size: 1.7rem; margin: 8px 0 16px; color: #fbfaf7; }
  .cta-card .eyebrow { color: var(--rose); }
  .btn {
    display: inline-block;
    background: #fbfaf7;
    color: var(--green-black);
    padding: 14px 30px;
    border-radius: 100px;
    font-weight: 600;
    font-size: 0.95rem;
    margin-top: 8px;
    text-decoration: none;
  }
  .btn:hover { background: #fff; opacity: 1; }

  /* Ontdek-zone: volledig donkergroen, inverse van de lichte Nieuws-zone */
  .ontdek-zone { background: var(--green-deep); padding: 88px 0 92px; position: relative; z-index: 5; }
  .ontdek-zone h2, .ontdek-zone h3 { color: #fbfaf7; }
  .ontdek-zone .see-all { color: #fbfaf7; border-bottom-color: var(--rose); }
</style>

<script is:inline>
  // is:inline i.p.v. gehoiste module-scripts: blijft daardoor ook werken in
  // een dubbelklik-vanaf-schijf-preview (file://), waar browsers
  // module-scripts blokkeren. Geen TypeScript-syntax, want dat wordt in een
  // is:inline-script niet getranspileerd.
  //
  // Aan het woord: kies bij elk bezoek willekeurig één citaat uit alle
  // ondernemers die er een hebben opgegeven. Server-side staat het eerste
  // citaat al vast in de HTML (zodat er ook zonder JS altijd iets staat) —
  // dit script vervangt dat na het laden door een écht willekeurige keuze.
  // Aan het woord toont 2 citaten tegelijk. Server-side staan de eerste 2
  // al vast in de HTML (zodat er ook zonder JS altijd iets staat) — dit
  // script kiest daarna, als er meer dan 2 citaten zijn, willekeurig 2
  // verschillende via een Fisher-Yates shuffle en vult daarmee de bestaande
  // kaartjes (1 op 1 per index, geen kaartjes toevoegen/verwijderen).
  var quotesWrap = document.getElementById('ondernemerQuotes');
  var quoteDataEl = document.getElementById('ondernemer-quotes');
  if (quotesWrap && quoteDataEl) {
    var quotes = JSON.parse(quoteDataEl.textContent || '[]');
    var blocks = quotesWrap.querySelectorAll('.reel-quote');
    if (quotes.length > blocks.length) {
      var shuffled = quotes.slice();
      for (var i = shuffled.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = shuffled[i];
        shuffled[i] = shuffled[j];
        shuffled[j] = tmp;
      }
      blocks.forEach(function (block, idx) {
        var gekozen = shuffled[idx];
        if (!gekozen) return;
        var blockquote = block.querySelector('blockquote');
        var who = block.querySelector('.who');
        if (blockquote) blockquote.textContent = gekozen.quote;
        if (who) who.textContent = gekozen.naam;
      });
    }
  }

  // Scroll reveal: gestaggerde fade+lift zodra content in beeld komt
  var revealItems = document.querySelectorAll('.reveal-item');
  var revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
  );

  var seenParents = new Map();
  revealItems.forEach((el) => {
    var parent = el.parentElement;
    var idx = seenParents.get(parent) || 0;
    el.style.transitionDelay = Math.min(idx * 70, 350) + 'ms';
    seenParents.set(parent, idx + 1);
    revealObserver.observe(el);
  });
</script>

<script type="module" is:inline>
  // Behold-widget laden — los script i.p.v. een <script src> tag, zodat het
  // ook in een file://-preview (dubbelklik-openen) zou laden i.p.v. stil te
  // falen; zie ook de is:inline-toelichting hierboven.
  (() => {
    const d = document, s = d.createElement('script');
    s.type = 'module';
    s.src = 'https://w.behold.so/widget.js';
    d.head.append(s);
  })();
</script>

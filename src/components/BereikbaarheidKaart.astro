---
// Kaart met vaste bereikbaarheids-POI's (parkeergarage + tramhaltes) i.p.v.
// ondernemerspins — apart component van OndernemersKaart.astro omdat de
// databron en interactie anders zijn: geen link naar een detailpagina, wel
// filteren per vervoerswijze via dezelfde route-kaartjes die al op de
// bereikbaarheid-pagina stonden. "Lopend" tekent de wandelroute Dam →
// Rozengracht, "Met de auto" tekent de korte looproute Parkeergarage →
// Rozengracht (zie routes hieronder) — "Fiets" heeft geen eigen pin/route en
// toont bij een klik gewoon weer alles. Locatiedata komt uit
// src/data/bereikbaarheid-places.json, gevuld door dezelfde "Places
// verversen" GitHub Action als de ondernemers-pins (zie
// scripts/fetch-places.mjs) — POI's zonder bekende locatie worden al vóór
// dit component eruit gefilterd (geen pin verzinnen).
export interface Props {
  items: { key: string; naam: string; vervoerswijze: 'auto' | 'ov'; lat: number; lng: number }[];
  // Eén route-lijn per filter-categorie die er een heeft. Puntenlijst i.p.v.
  // live Directions API: geen extra Google-afhankelijkheid/kosten in de
  // normale pageload voor routes die toch al vastliggen (zie de tekst bij de
  // route-kaartjes). Ontbreekt de data voor een categorie (bv. voordat de
  // Places-actie draaide), dan wordt er voor die categorie niets getekend —
  // geen route verzinnen.
  routes?: Partial<Record<'lopend' | 'auto', { lat: number; lng: number }[]>> | null;
  class?: string;
}
const { items, routes = null, class: className } = Astro.props;

// Zelfde publieke, referrer-beperkte sleutel als OndernemersKaart.astro.
const MAPS_KEY = 'AIzaSyCJ91Qc-ndwZUT2VVnHXbT3V--IN2KDmEQ';

// Hergebruikt twee kleuren uit de al gevalideerde categorie-palet van de
// ondernemerskaart (src/lib/categorieen.ts) — dat paar is daar al onder
// colorblind-simulatie als onderscheidbaar bevonden, dus geen aparte
// validatie nodig voor dit tweede, kleinere kleurenpaar. Elke pin krijgt
// bovendien hetzelfde lijn-icoon als het bijpassende route-kaartje eronder,
// zodat kleur nooit de enige drager van betekenis is. OV-pins zijn bewust
// groter dan de auto-pin: twee tramhaltes vallen anders te makkelijk weg
// tussen de straatnamen op de kaart.
const KLEUREN: Record<string, string> = {
  auto: '#D55E00',
  ov: '#0072B2',
};
const ICON_GROOTTES: Record<string, number> = {
  auto: 30,
  ov: 38,
};
const ICONEN: Record<string, string> = {
  auto: '<rect width="18" height="18" x="3" y="3" rx="2" /><path d="M9 17V7h4a3 3 0 0 1 0 6H9" />',
  ov: '<path d="M8 6v6" /><path d="M15 6v6" /><path d="M2 12h19.6" /><path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4a2 2 0 0 0-2 2v10h3" /><circle cx="7" cy="18" r="2" /><circle cx="16" cy="18" r="2" />',
};
function pinIconSvg(kleur: string, iconPath: string, grootte: number) {
  const r = grootte / 2 - 2;
  const iconBox = grootte * 0.533; // zelfde verhouding als het oorspronkelijke 30px-formaat (16/30)
  const offset = (grootte - iconBox) / 2;
  const schaal = iconBox / 24;
  return (
    `<svg xmlns="http://www.w3.org/2000/svg" width="${grootte}" height="${grootte}" viewBox="0 0 ${grootte} ${grootte}">` +
    `<circle cx="${grootte / 2}" cy="${grootte / 2}" r="${r}" fill="${kleur}" stroke="#ffffff" stroke-width="2"/>` +
    `<g transform="translate(${offset},${offset}) scale(${schaal})" fill="none" stroke="#ffffff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">${iconPath}</g>` +
    `</svg>`
  );
}
const markerIcons: Record<string, { url: string; size: number }> = {};
for (const [key, iconPath] of Object.entries(ICONEN)) {
  const grootte = ICON_GROOTTES[key] ?? 30;
  markerIcons[key] = {
    url: `data:image/svg+xml,${encodeURIComponent(pinIconSvg(KLEUREN[key], iconPath, grootte))}`,
    size: grootte,
  };
}

// Lijnkleur per route-categorie — "lopend" blijft het bestaande donkergroen
// (los van de pin-kleuren, want lopen heeft geen eigen pin), "auto" krijgt
// dezelfde kleur als de parkeergarage-pin zodat de twee zichtbaar bij elkaar
// horen.
const ROUTE_KLEUREN: Record<string, string> = {
  lopend: '#1b3b2f',
  auto: KLEUREN.auto,
};
---

<div
  id="bereikbaarheid-kaart"
  class:list={['locatie-kaart', className]}
  data-items={JSON.stringify(items)}
  data-marker-icons={JSON.stringify(markerIcons)}
  data-routes={routes ? JSON.stringify(routes) : ''}
  data-route-kleuren={JSON.stringify(ROUTE_KLEUREN)}
>
</div>

<script is:inline>
  // is:inline i.p.v. een gehoiste module-script — zelfde reden als elders
  // in deze codebase (blijft ook werken in een file://-preview).
  function initBereikbaarheidKaart() {
    var el = document.getElementById('bereikbaarheid-kaart');
    if (!el) return;
    var items = JSON.parse(el.dataset.items || '[]');
    if (items.length === 0) return;
    var iconMap = JSON.parse(el.dataset.markerIcons || '{}');
    var routes = el.dataset.routes ? JSON.parse(el.dataset.routes) : {};
    var routeKleuren = JSON.parse(el.dataset.routeKleuren || '{}');

    var map = new google.maps.Map(el, {
      center: { lat: 52.3735, lng: 4.8815 },
      zoom: 15,
    });

    var infoWindow = new google.maps.InfoWindow();
    var markers = [];

    items.forEach(function (item) {
      var positie = { lat: item.lat, lng: item.lng };
      var iconInfo = iconMap[item.vervoerswijze];
      var marker = new google.maps.Marker({
        position: positie,
        map: map,
        title: item.naam,
        icon: iconInfo
          ? {
              url: iconInfo.url,
              scaledSize: new google.maps.Size(iconInfo.size, iconInfo.size),
              anchor: new google.maps.Point(iconInfo.size / 2, iconInfo.size / 2),
            }
          : undefined,
      });
      marker.addListener('click', function () {
        infoWindow.setContent('<strong>' + item.naam + '</strong>');
        infoWindow.open(map, marker);
      });
      marker.vervoerswijze = item.vervoerswijze;
      markers.push(marker);
    });

    // Eén gestippelde polyline per route-categorie (bv. "lopend": Dam →
    // Rozengracht, "auto": Parkeergarage → Rozengracht) i.p.v. een gevulde
    // lijn, zodat die niet aanvoelt als een exacte navigatie-instructie maar
    // als een schematische aanduiding. Start onzichtbaar; wordt pas getoond
    // bij een klik op het bijpassende filter-kaartje hieronder.
    var routePolylines = {};
    Object.keys(routes).forEach(function (cat) {
      var pad = routes[cat];
      if (!pad || pad.length < 2) return;
      routePolylines[cat] = new google.maps.Polyline({
        path: pad,
        map: map,
        visible: false,
        strokeOpacity: 0,
        icons: [
          {
            icon: {
              path: 'M 0,-1 0,1',
              strokeOpacity: 1,
              strokeColor: routeKleuren[cat] || '#1b3b2f',
              strokeWeight: 3,
              scale: 3,
            },
            offset: '0',
            repeat: '14px',
          },
        ],
      });
    });

    // Past de kaartweergave aan op de zichtbare markers (en eventueel de
    // actieve route erbij). Bij precies één zichtbare marker en geen route
    // gebruiken we een vaste, redelijke zoom i.p.v. fitBounds — fitBounds op
    // één punt zoomt helemaal tot de maximale zoom (veel te dichtbij op een
    // los pand als de parkeergarage).
    function pasKaartAan(zichtbareMarkers, routePunten) {
      if (zichtbareMarkers.length === 0 && !routePunten) return;
      if (zichtbareMarkers.length === 1 && !routePunten) {
        map.setCenter(zichtbareMarkers[0].getPosition());
        map.setZoom(17);
        return;
      }
      var bounds = new google.maps.LatLngBounds();
      zichtbareMarkers.forEach(function (marker) {
        bounds.extend(marker.getPosition());
      });
      (routePunten || []).forEach(function (punt) {
        bounds.extend(punt);
      });
      map.fitBounds(bounds, 40);
    }

    // Standaard alles tonen — pas bij een klik op een route-kaartje wordt
    // er gefilterd.
    pasKaartAan(markers, null);

    // Reageert op dezelfde route-kaartjes eronder. "Fiets" beschrijft een
    // route zonder eigen pin/route-lijn en toont daarom gewoon weer alle
    // bekende POI's, net als de andere kaartjes doen voor hun eigen
    // vervoerswijze. "Lopend" en "Met de auto" tonen daarnaast hun eigen
    // route-lijn, als die er is.
    var filterBar = document.querySelector('[data-filters]');
    filterBar && filterBar.addEventListener('click', function (e) {
      var btn = e.target.closest('.filter-btn');
      if (!btn) return;
      var cat = btn.dataset.cat;
      var toonAlles = cat === 'lopend' || cat === 'fiets';
      var zichtbareMarkers = [];
      markers.forEach(function (marker) {
        var zichtbaar = toonAlles || marker.vervoerswijze === cat;
        marker.setVisible(zichtbaar);
        if (zichtbaar) zichtbareMarkers.push(marker);
      });
      var actieveRoute = routePolylines[cat] || null;
      Object.keys(routePolylines).forEach(function (routeCat) {
        routePolylines[routeCat].setVisible(routeCat === cat);
      });
      pasKaartAan(zichtbareMarkers, actieveRoute ? routes[cat] : null);
    });
  }
  window.initBereikbaarheidKaart = initBereikbaarheidKaart;
</script>
<script is:inline src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCJ91Qc-ndwZUT2VVnHXbT3V--IN2KDmEQ&callback=initBereikbaarheidKaart&loading=async" async></script>

<style>
  /* Zelfde opzet als .locatie-kaart in OndernemersKaart.astro, maar hier
     lokaal gehouden i.p.v. gedeeld — Astro's scoped CSS matcht toch alleen
     binnen hetzelfde bestand als de <style>, dus delen zou hier niets
     schelen. */
  .locatie-kaart {
    position: relative;
    aspect-ratio: 16/6;
    min-height: 260px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--color-border);
    margin: var(--space-lg) 0 0;
  }
</style>

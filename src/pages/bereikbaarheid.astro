---
import BaseLayout from '../layouts/BaseLayout.astro';
import BereikbaarheidKaart from '../components/BereikbaarheidKaart.astro';
import ContentCard from '../components/ContentCard.astro';
import bereikbaarheidPlekken from '../data/bereikbaarheid-places.json';
import bereikbaarheidRoutes from '../data/bereikbaarheid-routes.json';
import { getCollection, getEntry } from 'astro:content';
import { nieuwsToItem, resolveFoto } from '../lib/items';
import type { Lang } from '../lib/i18n';

const lang: Lang = 'nl';

const routes = [
  {
    titel: 'Lopend',
    cat: 'lopend',
    icoon: '<path d="M12 21s-7-5.4-7-11a7 7 0 1 1 14 0c0 5.6-7 11-7 11Z" /><circle cx="12" cy="10" r="2.5" />',
    tekst: 'Vanaf de Dam: neem de Raadhuisstraat westwaarts. Na de Westerkerk en de Westermarkt loopt die direct over in de Rozengracht, ongeveer 10 minuten lopen.',
  },
  {
    titel: 'Met de fiets',
    cat: 'fiets',
    icoon: '<circle cx="18.5" cy="17.5" r="3.5" /><circle cx="5.5" cy="17.5" r="3.5" /><circle cx="15" cy="5" r="1" /><path d="M12 17.5V14l-3-3 4-3 2 3h2" />',
    tekst: 'De Rozengracht heeft een eigen fietsstrook in beide richtingen en is goed verbonden met de Prinsengracht, die de straat kruist bij de Westermarkt.',
  },
  {
    titel: 'Met de auto',
    cat: 'auto',
    icoon: '<rect width="18" height="18" x="3" y="3" rx="2" /><path d="M9 17V7h4a3 3 0 0 1 0 6H9" />',
    tekst: 'Parkeren aan de Rozengracht zelf is beperkt en betaald. Parkeergarage Marnix (Marnixstraat 250) is de dichtstbijzijnde garage. De kaart hieronder toont ook de looproute daarvandaan naar de Rozengracht.',
  },
  {
    titel: 'Met het OV',
    cat: 'ov',
    icoon: '<path d="M8 6v6" /><path d="M15 6v6" /><path d="M2 12h19.6" /><path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4a2 2 0 0 0-2 2v10h3" /><circle cx="7" cy="18" r="2" /><circle cx="16" cy="18" r="2" />',
    tekst: 'Tram 13 en 17 stoppen op de Rozengracht zelf. De kaart hieronder toont alle tram- en bushaltes op de straat en tot 100 meter erbuiten.',
  },
];

// Vaste bereikbaarheids-POI's op de kaart hieronder — de "Fiets"-kaartje
// beschrijft een route, geen losse locatie, dus dat heeft bewust geen eigen
// pin (klikken erop toont gewoon weer alles). Locatiedata komt uit
// src/data/bereikbaarheid-places.json, gevuld door dezelfde "Places
// verversen" GitHub Action als de ondernemers-pins (zie
// scripts/fetch-places.mjs) — een POI zonder bekende locatie wordt hier
// overgeslagen (geen pin verzinnen).
const poiConfig = [
  { key: 'parkeergarage-marnix', naam: 'Parkeergarage Marnix', vervoerswijze: 'auto' },
  { key: 'tram-westermarkt', naam: 'Tramhalte Westermarkt', vervoerswijze: 'ov' },
  { key: 'tram-marnixstraat', naam: 'Tramhalte Marnixstraat', vervoerswijze: 'ov' },
];
const vastePois = poiConfig
  .map((poi) => {
    const plek = bereikbaarheidPlekken[poi.key];
    if (!plek || plek.lat == null || plek.lng == null) return null;
    return { key: poi.key, naam: poi.naam, vervoerswijze: poi.vervoerswijze, lat: plek.lat, lng: plek.lng };
  })
  .filter((x) => x !== null);

// Alle dynamisch gevonden tram-/bushaltes binnen 100m van de Rozengracht
// (zie scripts/fetch-places.mjs, "ov-"-sleutels) — bovenop de twee vaste
// tramhaltes hierboven, zodat ook overige haltes (bv. bus) op de kaart
// verschijnen zonder ze met de hand te hoeven bijhouden.
const dynamischeOvHaltes = Object.entries(bereikbaarheidPlekken)
  .filter(([key, plek]) => key.startsWith('ov-') && plek && plek.lat != null && plek.lng != null)
  .map(([key, plek]) => ({
    key,
    naam: plek.naamGevonden ?? 'Tram-/bushalte',
    vervoerswijze: 'ov',
    lat: plek.lat,
    lng: plek.lng,
  }));

const kaartItems = [...vastePois, ...dynamischeOvHaltes];

// De twee route-lijnen komen kant-en-klaar uit de Directions API (zie
// scripts/fetch-places.mjs, verversRoutes) — een echte, over-het-stratennet
// lopende polyline i.p.v. een handmatige keten van los opgezochte plekken
// (dat gaf alleen een paar rechte stukken dwars door blokken/grachten).
// Ontbreekt een route (bv. vóór de eerste "Places verversen"-run), dan
// wordt er niets getekend in plaats van een verzonnen lijn.
const walkRoute = bereikbaarheidRoutes.lopend?.length > 1 ? bereikbaarheidRoutes.lopend : null;
const garageRoute = bereikbaarheidRoutes.auto?.length > 1 ? bereikbaarheidRoutes.auto : null;

// Bereikbaarheids-updates zijn gewoon nieuwsartikelen met categorie
// "bereikbaarheid" (zie src/content/config.ts) — hier tonen we alleen de
// meest recente, actuele (een lijst van alle actieve updates voegde weinig
// toe zodra er meer dan één tegelijk actief is). Alle bereikbaarheids-
// updates, ook oudere/verlopen, blijven gewoon terug te vinden op /nieuws.
const vandaag = new Date();
const bereikbaarheidBerichten = (await getCollection('nieuws'))
  .filter((n) => n.data.categorie === 'bereikbaarheid')
  .filter((n) => !n.data.tot || n.data.tot >= vandaag)
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf());
const laatsteUpdateEntry = bereikbaarheidBerichten[0] ?? null;
const laatsteUpdateItem = laatsteUpdateEntry
  ? nieuwsToItem(
      laatsteUpdateEntry,
      laatsteUpdateEntry.data.gerelateerde_ondernemer
        ? await getEntry(laatsteUpdateEntry.data.gerelateerde_ondernemer)
        : null,
      await resolveFoto(laatsteUpdateEntry.data.foto, 640, laatsteUpdateEntry.data.fotoFocus),
      lang
    )
  : null;
---
<BaseLayout fullBleed title="Bereikbaarheid" description="Hoe je de Rozengracht in Amsterdam bereikt: lopend, fietsend, met de auto of het OV, plus actuele updates over werkzaamheden en evenementen." lang={lang}>
  <section class="bereik-zone">
    <div class="zone-inner">
      <span class="eyebrow">De straat</span>
      <h1>Bereikbaarheid</h1>
      <p class="intro">De Rozengracht loopt van oost naar west door de Jordaan en is vanuit alle richtingen goed te bereiken.</p>

      <section class="updates-section">
        {laatsteUpdateItem ? (
          <ContentCard item={laatsteUpdateItem} variant="compact" />
        ) : (
          <p class="geen-updates">Geen bijzonderheden op dit moment: de Rozengracht is normaal bereikbaar.</p>
        )}
      </section>

      <!-- Tegels boven de kaart, en compacter dan eerst: zo begint de kaart
           net binnen het beeld in plaats van eronder te verdwijnen. -->
      <div class="routes-grid" data-filters role="group" aria-label="Filter op vervoerswijze">
        {routes.map((route) => (
          <button type="button" class="route-card filter-btn" data-cat={route.cat} aria-pressed="false">
            <span class="route-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={route.icoon} />
            </span>
            <h2>{route.titel}</h2>
            <p>{route.tekst}</p>
          </button>
        ))}
      </div>

      {kaartItems.length > 0 && <BereikbaarheidKaart items={kaartItems} routes={{ lopend: walkRoute, auto: garageRoute }} />}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // is:inline i.p.v. een gehoiste module-script, zelfde reden als elders in
  // deze codebase. Regelt alleen de visuele is-active status van de
  // route-kaartjes zelf — het filteren van de pins gebeurt onafhankelijk in
  // BereikbaarheidKaart.astro, die naar dezelfde [data-filters] klikken
  // luistert.
  var routeFilterBar = document.querySelector('.routes-grid[data-filters]');
  routeFilterBar && routeFilterBar.addEventListener('click', (e) => {
    var btn = e.target.closest('.filter-btn');
    if (!btn) return;
    routeFilterBar.querySelectorAll('.filter-btn').forEach((b) => {
      b.classList.remove('is-active');
      b.setAttribute('aria-pressed', 'false');
    });
    btn.classList.add('is-active');
    btn.setAttribute('aria-pressed', 'true');
  });
</script>

<style>
  /* Donkergroene pagina op verzoek: de bereikbaarheidspagina is de plek waar
     mensen komen kijken of ze er wel kunnen komen, en die mag zich
     onderscheiden van de rest van de site. Loopt van rand tot rand, vandaar
     fullBleed op de layout en de 100vw-truc hieronder. */
  .bereik-zone {
    background: var(--green-deep);
    color: #fbfaf7;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding: var(--space-lg) 0 var(--space-xl);
    min-height: 100vh;
  }
  .zone-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-md);
  }
  .bereik-zone :global(h1) { color: #fbfaf7; }
  .eyebrow {
    display: block;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rose);
    font-weight: 600;
    margin-bottom: 6px;
  }
  .intro { color: rgba(251, 250, 247, 0.78); max-width: 560px; margin-top: var(--space-xs); }

  /* Compacter dan eerst (icoon naast de tekst i.p.v. erboven, minder padding)
     zodat alle vier de tegels op een rij passen en de kaart eronder nog
     binnen het beeld begint. */
  .routes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-sm);
    margin: var(--space-lg) 0 var(--space-md);
  }
  /* Dat het knoppen zijn moest duidelijker: ze hebben nu een eigen vlak met
     rand, een chevron die bij hover meebeweegt, en een duidelijk andere
     ingedrukte staat (wit vlak, donkere tekst). */
  .route-card {
    position: relative;
    display: grid;
    grid-template-columns: 34px 1fr 14px;
    align-items: start;
    gap: 12px;
    width: 100%;
    text-align: left;
    font: inherit;
    color: #fbfaf7;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.26);
    border-radius: 12px;
    padding: 14px 14px 14px 12px;
    cursor: pointer;
    touch-action: manipulation;
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .route-card:hover { background: rgba(255, 255, 255, 0.13); border-color: rgba(255, 255, 255, 0.45); }
  .route-card:hover .route-chevron { transform: translateX(3px); }
  .route-card:focus-visible { outline: 2px solid #fbfaf7; outline-offset: 2px; }
  .route-card.is-active {
    background: #fbfaf7;
    border-color: #fbfaf7;
    color: var(--green-deep);
  }
  .route-card.is-active .route-icon { background: var(--green-deep); color: #fbfaf7; }
  .route-card.is-active p { color: rgba(20, 52, 42, 0.75); }

  .route-icon {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
    color: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }
  .route-icon svg { width: 18px; height: 18px; }
  .route-card h2 { font-size: 0.98rem; margin: 2px 0 4px; color: inherit; }
  .route-card p {
    font-size: 0.84rem;
    line-height: 1.45;
    color: rgba(251, 250, 247, 0.72);
    margin: 0;
    /* Twee regels, de rest staat in de kaart eronder: anders duwen deze
       tegels de kaart weer uit het beeld. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .route-chevron { align-self: center; opacity: 0.7; transition: transform 0.15s ease; }
  .route-chevron svg { width: 14px; height: 14px; display: block; }

  .updates-section { margin-top: var(--space-md); }
  .geen-updates {
    color: rgba(251, 250, 247, 0.78);
    background: rgba(255, 255, 255, 0.06);
    border: 1px dashed rgba(255, 255, 255, 0.3);
    border-radius: var(--radius);
    padding: var(--space-md);
  }
  @media (prefers-reduced-motion: reduce) {
    .route-card, .route-chevron { transition: none; }
  }
</style>

---
// De losse nieuwspagina bestaat niet meer: alle artikelen staan door elkaar op
// Ontdek. Deze pagina blijft alleen staan om bezoekers en zoekmachines met een
// oude link (bladwijzer, oud zoekresultaat) door te sturen. Losse statische
// pagina i.p.v. een astro.config.mjs-redirect, net als /lezen: werkt hetzelfde
// op een static build en config.mjs is gedeeld gebied.
import { getRelativeLocaleUrl } from 'astro:i18n';

const doel = getRelativeLocaleUrl('en', 'ontdek/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${doel}`} />
    <link rel="canonical" href={doel} />
    <meta name="robots" content="noindex" />
    <title>News is now on Discover</title>
  </head>
  <body>
    <p>All articles are now on <a href={doel}>Discover</a>.</p>
    <script define:vars={{ doel }}>
      window.location.replace(doel);
    </script>
  </body>
</html>

---
// Homepage als magazine-landing (topic 03), Engelse versie. Zelfde opbouw
// als src/pages/index.astro via de gedeelde componenten in
// src/components/home/ — zie dat bestand voor de toelichting.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BereikbaarheidBar from '../../components/home/BereikbaarheidBar.astro';
import EventHighlight from '../../components/home/EventHighlight.astro';
import BlogWall from '../../components/home/BlogWall.astro';
import InstagramFeed from '../../components/home/InstagramFeed.astro';
import NieuwOpDeRozengracht from '../../components/home/NieuwOpDeRozengracht.astro';
import AanHetWoord from '../../components/home/AanHetWoord.astro';
import OndernemersCta from '../../components/home/OndernemersCta.astro';
import BizSectie from '../../components/home/BizSectie.astro';
import type { Lang } from '../../lib/i18n';

const lang: Lang = 'en';
---
<BaseLayout title="Home" fullBleed lang={lang}>
  <h1 class="visually-hidden">BIZ Ondernemersvereniging Rozengracht, Amsterdam</h1>

  <BereikbaarheidBar lang={lang} />
  <div class="container event-highlight-wrap">
    <EventHighlight lang={lang} />
  </div>
  <BlogWall lang={lang} />

  <section class="section ontdek-zone" id="ontdek">
    <div class="container">
      <div class="ontdek-intro">
        <span class="eyebrow">The other side of the street</span>
        <h2>Discover</h2>
      </div>

      <InstagramFeed lang={lang} />

      <div class="ondernemers-layout" id="ondernemers">
        <NieuwOpDeRozengracht lang={lang} />
        <AanHetWoord lang={lang} />
      </div>

      <OndernemersCta lang={lang} />
      <BizSectie lang={lang} />
    </div>
  </section>
</BaseLayout>

<style>
  .event-highlight-wrap { padding-top: 32px; }
  .ontdek-zone { background: var(--green-deep); padding: 88px 0 92px; position: relative; z-index: 5; }
  .ontdek-zone h2, .ontdek-zone h3 { color: #fbfaf7; }
  .ontdek-intro { margin-bottom: 32px; }
  .ontdek-intro .eyebrow {
    display: block;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rose);
    font-weight: 600;
    margin-bottom: 6px;
  }
  .ondernemers-layout { margin-top: 76px; display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start; }
  .ondernemers-layout > :only-child { grid-column: 1 / -1; }
  @media (max-width: 900px) {
    .ondernemers-layout { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  // Scroll reveal: gestaggerde fade+lift zodra content in beeld komt.
  // Pas hier de animatie aanzetten: de CSS houdt alles zichtbaar tot deze
  // klasse er staat, zodat een pagina nooit leeg blijft als dit script om
  // welke reden dan ook niet aan bod komt.
  document.documentElement.classList.add('reveal-aan');
  var revealItems = document.querySelectorAll('.reveal-item');
  var revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
  );

  var seenParents = new Map();
  revealItems.forEach((el) => {
    var parent = el.parentElement;
    var idx = seenParents.get(parent) || 0;
    el.style.transitionDelay = Math.min(idx * 70, 350) + 'ms';
    seenParents.set(parent, idx + 1);
    revealObserver.observe(el);
  });

  // Vangnet: mocht de observer niet afgaan (te korte pagina, rare
  // viewport-situatie, iets in de browser), dan staat na een seconde alles
  // alsnog zichtbaar. Liever een animatie die overslaat dan lege vlakken.
  setTimeout(function () {
    revealItems.forEach(function (el) { el.classList.add('is-visible'); });
  }, 1000);
</script>

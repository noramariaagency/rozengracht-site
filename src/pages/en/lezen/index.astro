---
// "Lezen" heet nu "Ontdek" — deze pagina bestaat alleen nog om bezoekers en
// zoekmachines die de oude URL hebben (bladwijzer, oud zoekresultaat) door te
// sturen. Losse statische pagina i.p.v. een astro.config.mjs-redirect: dat
// werkt hetzelfde op een static build en config.mjs is gedeeld gebied.
import { getRelativeLocaleUrl } from 'astro:i18n';

const doel = getRelativeLocaleUrl('en', 'ontdek/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${doel}`} />
    <link rel="canonical" href={doel} />
    <meta name="robots" content="noindex" />
    <title>Read is now Ontdek</title>
  </head>
  <body>
    <p>This page is now called <a href={doel}>Ontdek</a>.</p>
    <script define:vars={{ doel }}>
      window.location.replace(doel);
    </script>
  </body>
</html>

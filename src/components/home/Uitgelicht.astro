---
// "Uitgelicht": een korte mix van historie-verhalen en ondernemers, elk met
// een korte samenvatting (punt 3 uit de briefing) — de plek waar een
// ondernemer af en toe wél naar voren komt, zonder dat de homepage een
// ondernemerslijst wordt (dat blijft voorbehouden aan /ondernemers).
//
// Geen editorial "uitgelicht"-vlag in het schema (dat zou config.ts raken,
// gesloten gebied na topic 01) — de selectie rouleert daarom automatisch per
// week uit een ruimere kandidatenpool, zodat dit geen handmatig bij te
// houden lijstje wordt en er geen bevoorrechte ondernemer ontstaat.
import ContentCard from '../ContentCard.astro';
import { getCollection, getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { verhaalToItem, ondernemerToItem, resolveFoto } from '../../lib/items';
import type { Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'nl' } = Astro.props;

// Roulatie-index op basis van het week nummer van het jaar: verandert bij elke
// nieuwe build in een nieuwe week, maar niet bij elke losse pageview/build op
// dezelfde dag — geen client-side randomness nodig voor deze sectie.
function weekIndex(): number {
  const nu = new Date();
  const start = new Date(nu.getFullYear(), 0, 1);
  return Math.floor((nu.getTime() - start.getTime()) / (7 * 24 * 60 * 60 * 1000));
}
const week = weekIndex();

// Eén verhaal, rouleert wekelijks door alle historie-artikelen.
const alleVerhalen = await getCollection('verhalen');
let verhaalItem = null;
if (alleVerhalen.length > 0) {
  const gekozenVerhaal = alleVerhalen[week % alleVerhalen.length];
  const ondernemer = gekozenVerhaal.data.gerelateerde_ondernemer
    ? await getEntry(gekozenVerhaal.data.gerelateerde_ondernemer)
    : null;
  const foto = await resolveFoto(gekozenVerhaal.data.foto, 640, gekozenVerhaal.data.fotoFocus);
  verhaalItem = verhaalToItem(gekozenVerhaal, ondernemer, foto, lang);
}

// Twee ondernemers uit de kandidatenpool (foto + eigen quote aanwezig, dus
// aantoonbaar een compleet profiel), rouleert wekelijks door de hele pool.
const kandidaten = (
  await getCollection('ondernemers', ({ data }) => data.status !== 'overslaan' && data.status !== 'geen-interesse')
).filter((o) => o.data.fotos.length > 0 && o.data.quote_nl);
const ondernemerItems = await Promise.all(
  Array.from({ length: Math.min(2, kandidaten.length) }, (_, i) => kandidaten[(week + i) % kandidaten.length]).map(
    async (o) => {
      const foto = await getImage({ src: o.data.fotos[0], width: 640 });
      return ondernemerToItem(o, { src: foto.src, width: foto.attributes.width, height: foto.attributes.height, focus: null }, lang);
    }
  )
);

const items = [verhaalItem, ...ondernemerItems].filter((x) => x !== null);

const TEKST: Record<Lang, { eyebrow: string; titel: string }> = {
  nl: { eyebrow: 'Uit de straat', titel: 'Uitgelicht' },
  en: { eyebrow: 'From the street', titel: 'Featured' },
};
const t = TEKST[lang];
---
{items.length > 0 && (
  <section class="section uitgelicht" id="uitgelicht">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{t.eyebrow}</span>
        <h2>{t.titel}</h2>
      </div>
      <div class="uitgelicht-grid" style="--card-foto-ratio: 4/3; --card-title-size: 1.1rem;">
        {items.map((item) => (
          <div class="reveal-item">
            <ContentCard item={item} variant="feature" />
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .section { position: relative; padding: 16px 0 56px; scroll-margin-top: var(--nav-height); }
  .section-head { margin-bottom: 20px; }
  .section-head h2 { font-size: 1.9rem; }
  .eyebrow {
    display: block;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rose-deep);
    font-weight: 600;
    margin-bottom: 6px;
  }
  .uitgelicht-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  @media (max-width: 900px) {
    .uitgelicht-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) {
    .uitgelicht-grid { grid-template-columns: 1fr; }
  }
  .reveal-item {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .reveal-item.is-visible { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    .reveal-item { opacity: 1; transform: none; transition: none; }
  }
</style>
